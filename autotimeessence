-- AUTO MINIGAME - FULL SCRIPT

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- REMOVE OLD GUI
for _, Container in ipairs({PlayerGui, game:GetService("CoreGui")}) do
    pcall(function()
        local Old = Container:FindFirstChild("Rayfield")
        if Old then
            Old:Destroy()
        end
    end)

    pcall(function()
        local Old = Container:FindFirstChild("Auto Minigame")
        if Old then
            Old:Destroy()
        end
    end)
end

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Auto TP System",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "AutoMinigame",
        FileName = "Config"
    },
    KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)

local Flags = {
    AutoPunch = true,
    AutoMinigame = true,
    AutoRejoin = true,
    AutoExecute = true,
    FaceItrapped = true
}

local SequenceStarted = false
local RejoinStarted = false
local ItrappedSeen = false
local LastEssenceValue = nil

local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function GetEssences()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essences = Leaderstats
        and Leaderstats:FindFirstChild("Time Essences")

    return Essences and Essences.Value or nil
end

local function TeleportTo(Position)
    local Root = GetRoot()
    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- QUEUE AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction

    pcall(function()
        QueueFunction = queue_on_teleport
    end)

    if not QueueFunction then
        pcall(function()
            QueueFunction = syn.queue_on_teleport
        end)
    end

    if not QueueFunction then
        pcall(function()
            QueueFunction = fluxus.queue_on_teleport
        end)
    end

    if not QueueFunction then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
            ))()
        ]])
    end)
end

-- HEALTH AT TOP
local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

-- TOGGLES
MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        Flags.AutoPunch = Value
    end
})

MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",
    Callback = function(Value)
        Flags.AutoMinigame = Value

        if not Value then
            SequenceStarted = false
        end
    end
})

MainTab:CreateToggle({
    Name = "Auto Rejoin",
    CurrentValue = true,
    Flag = "AutoRejoin",
    Callback = function(Value)
        Flags.AutoRejoin = Value

        if not Value then
            RejoinStarted = false
        end
    end
})

MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = true,
    Flag = "AutoExecute",
    Callback = function(Value)
        Flags.AutoExecute = Value

        if Value then
            QueueAutoExecute()
        end
    end
})

MainTab:CreateToggle({
    Name = "Always Face Itrapped",
    CurrentValue = true,
    Flag = "FaceItrapped",
    Callback = function(Value)
        Flags.FaceItrapped = Value

        local Humanoid = GetHumanoid()
        if Humanoid and not Value then
            Humanoid.AutoRotate = true
        end
    end
})

-- AUTO PUNCH LOOP
task.spawn(function()
    while task.wait(0.1) do
        if Flags.AutoPunch then
            local Character = GetCharacter()
            local Punch = Character and Character:FindFirstChild("Punch")
            local Remote = Punch and Punch:FindFirstChild("RemoteEvent")

            if Remote then
                pcall(function()
                    Remote:FireServer()
                end)
            end
        end
    end
end)

-- HEALTH AND DEFEAT MONITOR
task.spawn(function()
    while task.wait(0.25) do
        local Target = workspace:FindFirstChild("Itrapped")
        local Humanoid = Target and Target:FindFirstChildOfClass("Humanoid")

        if Humanoid and Humanoid.Health > 0 then
            ItrappedSeen = true
            LastEssenceValue = GetEssences()

            pcall(function()
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = string.format(
                        "Health: %d / %d",
                        math.floor(Humanoid.Health),
                        math.floor(Humanoid.MaxHealth)
                    )
                })
            end)

        elseif ItrappedSeen then
            ItrappedSeen = false

            Rayfield:Notify({
                Title = "Itrapped Has Been Defeated",
                Content = "Checking Time Essence reward...",
                Duration = 4
            })

            task.wait(1)

            local CurrentEssences = GetEssences()

            if CurrentEssences ~= nil
                and LastEssenceValue ~= nil
                and CurrentEssences > LastEssenceValue then

                Rayfield:Notify({
                    Title = "Time Essence",
                    Content = "You Got Time Essence!",
                    Duration = 4
                })
            else
                Rayfield:Notify({
                    Title = "Time Essence",
                    Content = "You Don't Get Time Essence, GL Next Time",
                    Duration = 4
                })
            end

            pcall(function()
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Waiting for Itrapped..."
                })
            end)

            if Flags.AutoRejoin and not RejoinStarted then
                RejoinStarted = true

                if Flags.AutoExecute then
                    QueueAutoExecute()
                end

                pcall(function()
                    TeleportService:Teleport(game.PlaceId, Player)
                end)
            end
        end
    end
end)

-- REJOIN IMMEDIATELY WHILE FROZEN TUNDRA EXISTS
task.spawn(function()
    while task.wait(0.2) do
        if Flags.AutoRejoin
            and workspace:FindFirstChild("Frozen Tundra")
            and not RejoinStarted then

            RejoinStarted = true

            if Flags.AutoExecute then
                QueueAutoExecute()
            end

            local Success = pcall(function()
                TeleportService:Teleport(game.PlaceId, Player)
            end)

            if not Success then
                RejoinStarted = false
            end
        end
    end
end)

-- RESET REJOIN STATE ON CHARACTER RESPAWN
Player.CharacterAdded:Connect(function()
    RejoinStarted = false
    SequenceStarted = false
end)

-- TP SEQUENCE
task.spawn(function()
    while task.wait(0.2) do
        if Flags.AutoMinigame and not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                -- WAIT 16 SECONDS
                task.wait(16)

                if not Flags.AutoMinigame then
                    SequenceStarted = false
                    return
                end

                -- TP1 UNTIL BATTLEFIELD IS GONE
                -- AND FROZEN TUNDRA APPEARS
                while Flags.AutoMinigame do
                    local Battlefield =
                        workspace:FindFirstChild("Battlefield")

                    local FrozenTundra =
                        workspace:FindFirstChild("Frozen Tundra")

                    if not Battlefield and FrozenTundra then
                        break
                    end

                    TeleportTo(Vector3.new(99, -18, 193))
                    task.wait(0.2)
                end

                if not Flags.AutoMinigame then
                    SequenceStarted = false
                    return
                end

                -- TP2 UNTIL ITRAPPED APPEARS
                while Flags.AutoMinigame do
                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot =
                        Target and Target:FindFirstChild("HumanoidRootPart")

                    if TargetRoot then
                        break
                    end

                    TeleportTo(Vector3.new(85, -16, 59))
                    task.wait(0.2)
                end

                -- FOLLOW ITRAPPED FROM BEHIND
                while Flags.AutoMinigame do
                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot =
                        Target and Target:FindFirstChild("HumanoidRootPart")
                    local Root = GetRoot()

                    if not TargetRoot or not Root then
                        break
                    end

                    pcall(function()
                        Root.CFrame =
                            TargetRoot.CFrame * CFrame.new(0, 0, 3)

                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end)

                    RunService.Heartbeat:Wait()
                end

                SequenceStarted = false
            end)
        end
    end
end)

-- ALWAYS FACE ITRAPPED
RunService:BindToRenderStep(
    "AutoMinigameFaceItrapped",
    Enum.RenderPriority.Character.Value + 1,
    function()
        if not Flags.FaceItrapped then
            return
        end

        local Character = workspace:FindFirstChild(Player.Name)
            or GetCharacter()

        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")

        local Target = workspace:FindFirstChild("Itrapped")
        local TargetRoot =
            Target and Target:FindFirstChild("HumanoidRootPart")

        if not Root or not Humanoid or not TargetRoot then
            if Humanoid then
                Humanoid.AutoRotate = true
            end
            return
        end

        Humanoid.AutoRotate = false

        local MyPosition = Root.Position
        local TargetPosition = TargetRoot.Position

        local FlatTarget = Vector3.new(
            TargetPosition.X,
            MyPosition.Y,
            TargetPosition.Z
        )

        if (FlatTarget - MyPosition).Magnitude > 0.01 then
            Root.CFrame = CFrame.lookAt(MyPosition, FlatTarget)
        end
    end
)

-- INITIAL AUTO EXECUTE QUEUE
if Flags.AutoExecute then
    QueueAutoExecute()
end

Rayfield:Notify({
    Title = "Auto Minigame",
    Content = "Script loaded!",
    Duration = 4
})
