-- CHARACTER HELPERS
local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local character = GetCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local character = GetCharacter()
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function Notify(title, content, duration)
    if not IsCurrentInstance() then return end

    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = content,
            Duration = duration or 4
        })
    end)
end

local function TeleportTo(position)
    if not IsCurrentInstance() then return false end

    local root = GetRoot()
    if not root then return false end

    return pcall(function()
        root.CFrame = CFrame.new(position)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- AUTO EXECUTE
local function QueueAutoExecute()
    local queueFunction

    pcall(function()
        if type(queue_on_teleport) == "function" then
            queueFunction = queue_on_teleport
        elseif type(syn) == "table"
            and type(syn.queue_on_teleport) == "function" then
            queueFunction = syn.queue_on_teleport
        elseif type(fluxus) == "table"
            and type(fluxus.queue_on_teleport) == "function" then
            queueFunction = fluxus.queue_on_teleport
        end
    end)

    if not queueFunction then
        warn("Auto Execute: queue_on_teleport unavailable.")
        return false
    end

    local success, err = pcall(function()
        queueFunction([[
            task.wait(2)
            local ok, err = pcall(function()
                loadstring(game:HttpGet(
                    "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
                ))()
            end)
            if not ok then
                warn("Auto Execute failed:", tostring(err))
            end
        ]])
    end)

    if not success then
        warn("Auto Execute queue failed:", tostring(err))
    end

    return success
end

-- REJOIN SYSTEM
local function StopAutomationForRejoin()
    SequenceStarted = false

    local humanoid = GetHumanoid()
    if humanoid then
        humanoid.AutoRotate = true
    end
end

local AttemptTeleport

local function ScheduleTeleportRetry(generation)
    if not IsCurrentInstance()
        or not RejoinStarted
        or TeleportRetryScheduled
        or generation ~= RejoinGeneration then
        return
    end

    if TeleportAttempts >= MaxTeleportAttempts then
        RejoinStarted = false
        TeleportInProgress = false
        TeleportRetryScheduled = false
        Notify("Auto Rejoin", "Maximum retry attempts reached.", 5)
        return
    end

    TeleportRetryScheduled = true

    task.delay(2, function()
        if not IsCurrentInstance()
            or not RejoinStarted
            or generation ~= RejoinGeneration then
            TeleportRetryScheduled = false
            return
        end

        TeleportRetryScheduled = false
        AttemptTeleport(generation)
    end)
end

AttemptTeleport = function(generation)
    if not IsCurrentInstance()
        or not RejoinStarted
        or generation ~= RejoinGeneration
        or TeleportInProgress then
        return
    end

    if TeleportAttempts >= MaxTeleportAttempts then
        RejoinStarted = false
        Notify("Auto Rejoin", "Maximum retry attempts reached.", 5)
        return
    end

    TeleportAttempts += 1
    local attempt = TeleportAttempts
    local delayTime = math.min(attempt * 3, 20)

    task.delay(delayTime, function()
        if not IsCurrentInstance()
            or not RejoinStarted
            or generation ~= RejoinGeneration then
            return
        end

        TeleportInProgress = true

        local success, err = pcall(function()
            TeleportService:Teleport(game.PlaceId, Player)
        end)

        if not success then
            TeleportInProgress = false
            warn("Rejoin attempt " .. attempt .. " failed:", tostring(err))
            ScheduleTeleportRetry(generation)
        end
        -- On a successful API call, wait for teleport completion or
        -- TeleportInitFailed. Roblox does not guarantee teleport success.
    end)
end

TrackConnection(TeleportService.TeleportInitFailed:Connect(
    function(failedPlayer, result, errorMessage)
        if failedPlayer ~= Player
            or not RejoinStarted
            or not IsCurrentInstance() then
            return
        end

        TeleportInProgress = false
        warn("Teleport failed:", tostring(result), tostring(errorMessage))
        ScheduleTeleportRetry(RejoinGeneration)
    end
))

local function RequestRejoin()
    if RejoinStarted or not IsCurrentInstance() then return end
    if not Flags.AutoRejoin then
        Notify("Auto Rejoin", "Auto Rejoin is OFF.", 3)
        return
    end

    RejoinStarted = true
    InitialRejoinTriggered = true
    RejoinGeneration += 1
    TeleportAttempts = 0
    TeleportRetryScheduled = false
    TeleportInProgress = false

    StopAutomationForRejoin()

    if Flags.AutoExecute then
        QueueAutoExecute()
    end

    local generation = RejoinGeneration
    task.delay(0.5, function()
        if IsCurrentInstance()
            and RejoinStarted
            and generation == RejoinGeneration then
            AttemptTeleport(generation)
        end
    end)
end

