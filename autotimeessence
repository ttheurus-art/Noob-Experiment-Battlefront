-- SERVICES
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local Player = Players.LocalPlayer

-- CONFIG
local Flags = {
    AutoPunch = true,
    AutoMinigame = true,
    AutoRejoin = true
}

local SequenceStarted = false
local ItrappedSeen = false
local RejoinStarted = false
local AutoExecuteEnabled = true

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Automation Panel",
    ConfigurationSaving = {
        Enabled = false
    }
})

local MainTab = Window:CreateTab("Main", 4483362458)

-- HEALTH PARAGRAPH
local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

-- AUTO PUNCH
MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        Flags.AutoPunch = Value
    end
})

-- AUTO MINIGAME
MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",
    Callback = function(Value)
        Flags.AutoMinigame = Value

        if Value then
