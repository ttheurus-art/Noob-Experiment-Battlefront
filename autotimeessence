-- AUTO MINIGAME TELEPORT SEQUENCE
task.spawn(function()
    while task.wait(0.2) do
        if not IsCurrentInstance()
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        if Flags.AutoMinigame and not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                task.wait(16)

                if not IsCurrentInstance()
                    or not Flags.AutoMinigame
                    or RejoinStarted
                    or InitialRejoinTriggered then
                    SequenceStarted = false
                    return
                end

                -- TP1
                while Flags.AutoMinigame
                    and not RejoinStarted
                    and not InitialRejoinTriggered do

                    local Battlefield = workspace:FindFirstChild("Battlefield")
                    local FrozenTundra = workspace:FindFirstChild("Frozen Tundra")

                    if not Battlefield and FrozenTundra then
                        break
                    end

                    TeleportTo(Vector3.new(99, -18, 193))
                    task.wait(0.2)
                end

                if not Flags.AutoMinigame
                    or RejoinStarted
                    or InitialRejoinTriggered then
                    SequenceStarted = false
                    return
                end

                -- TP2
                while Flags.AutoMinigame
                    and not RejoinStarted
                    and not InitialRejoinTriggered do

                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot = Target
                        and Target:FindFirstChild("HumanoidRootPart")

                    if TargetRoot then
                        break
                    end

                    TeleportTo(Vector3.new(85, -16, 59))
                    task.wait(0.2)
                end

                -- FOLLOW ITRAPPED
                while Flags.AutoMinigame
                    and not RejoinStarted
                    and not InitialRejoinTriggered do

                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot = Target
                        and Target:FindFirstChild("HumanoidRootPart")
                    local Root = GetRoot()

                    if not TargetRoot or not Root then
                        break
                    end

                    pcall(function()
                        Root.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, 3)
                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end)

                    RunService.Heartbeat:Wait()
                end

                SequenceStarted = false
            end)
        end
    end
end)

-- ALWAYS FACE ITRAPPED
RunService:BindToRenderStep(
    RenderName,
    Enum.RenderPriority.Character.Value + 1,
    function()
        if not IsCurrentInstance()
            or not Flags.FaceItrapped
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        local Character = workspace:FindFirstChild(Player.Name)
            or GetCharacter()

        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")

        local Target = workspace:FindFirstChild("Itrapped")
        local TargetRoot = Target
            and Target:FindFirstChild("HumanoidRootPart")

        if not Root or not Humanoid or not TargetRoot then
            if Humanoid then
                Humanoid.AutoRotate = true
            end
            return
        end

        Humanoid.AutoRotate = false

        local MyPosition = Root.Position
        local TargetPosition = TargetRoot.Position

        local FlatTarget = Vector3.new(
            TargetPosition.X,
            MyPosition.Y,
            TargetPosition.Z
        )

        if (FlatTarget - MyPosition).Magnitude > 0.01 then
            Root.CFrame = CFrame.lookAt(MyPosition, FlatTarget)
        end
    end
)

