-- AUTO PUNCH LOOP
--==================================================

task.spawn(function()
    while task.wait(0.1) do
        if not Flags.AutoPunch then
            continue
        end

        local Character = Player.Character
        local Punch = Character and Character:FindFirstChild("Punch")
        local Remote = Punch and Punch:FindFirstChild("RemoteEvent")

        if Remote and Remote:IsA("RemoteEvent") then
            pcall(function()
                Remote:FireServer()
            end)
        end
    end
end)

--==================================================
-- TP 1 + TP 2
--==================================================

task.spawn(function()
    while task.wait(0.1) do
        if not Flags.AutoMinigame or SequenceStarted then
            continue
        end

        SequenceStarted = true

        task.spawn(function()
            task.wait(INITIAL_DELAY)

            if not Flags.AutoMinigame then
                SequenceStarted = false
                return
            end

            -- TP 1: STOP WHEN FROZEN TUNDRA APPEARS
            while Flags.AutoMinigame do
                if workspace:FindFirstChild("Frozen Tundra") then
                    break
                end

                TeleportTo(TP1_POSITION)
                task.wait(TP_INTERVAL)
            end

            if not Flags.AutoMinigame then
                SequenceStarted = false
                return
            end

            -- TP 2: STOP WHEN ITRAPPED APPEARS
            while Flags.AutoMinigame do
                if workspace:FindFirstChild("Itrapped") then
                    break
                end

                TeleportTo(TP2_POSITION)
                task.wait(TP_INTERVAL)
            end

            SequenceStarted = false
        end)
    end
end)

--==================================================
-- TP 3: FOLLOW ITRAPPED EVERY FRAME
--==================================================

RunService.Heartbeat:Connect(function()
    if not Flags.AutoMinigame then
        return
    end

    local Target = workspace:FindFirstChild("Itrapped")
    if not Target then
        return
    end

    local TargetRoot =
        Target:FindFirstChild("HumanoidRootPart")
        or Target.PrimaryPart

    local Character = Player.Character
    local PlayerRoot = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not TargetRoot or not PlayerRoot then
        return
    end

    pcall(function()
        PlayerRoot.CFrame = TargetRoot.CFrame
    end)
end)

--==================================================
-- INITIAL JOIN CHECK
-- REJOIN IF FROZEN TUNDRA APPEARS WITHIN 5 SECONDS
--==================================================

task.spawn(function()
    local StartTime = os.clock()

    while os.clock() - StartTime < JOIN_CHECK_DURATION do
        if workspace:FindFirstChild("Frozen Tundra") then
            if Flags.AutoRejoin then
                task.delay(1, AutoRejoin)
            end
            return
        end

        task.wait(0.1)
    end
end)

--==================================================
-- ITRAPPED HEALTH + DEFEAT MONITOR
-- START AFTER FROZEN TUNDRA, THEN WAIT 1 SECOND
--==================================================

task.spawn(function()
    local MapReady = false
    local TargetWasDetected = false
    local DefeatHandledLocal = false
    local PreviousEssence = nil

    local function GetTimeEssence()
        local Leaderstats = Player:FindFirstChild("leaderstats")
        local Essence = Leaderstats
            and Leaderstats:FindFirstChild("Time Essences")

        if Essence and (
            Essence:IsA("IntValue")
            or Essence:IsA("NumberValue")
        ) then
            return Essence.Value
        end

        return nil
    end

    -- Wait until Frozen Tundra appears.
    while task.wait(0.1) do
        if workspace:FindFirstChild("Frozen Tundra") then
            break
        end
    end

    -- Wait 1 second before starting Itrapped detection.
    task.wait(1)

    MapReady = true
    PreviousEssence = GetTimeEssence()

    while task.wait(0.2) do
        if not MapReady then
            continue
        end

        if not workspace:FindFirstChild("Frozen Tundra") then
            continue
        end

        local Target = workspace:FindFirstChild("Itrapped")

        if Target then
            TargetWasDetected = true
            DefeatHandledLocal = false

            local Humanoid = Target:FindFirstChildOfClass("Humanoid")

            if Humanoid then
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Health: "
                        .. math.floor(Humanoid.Health)
                        .. " / "
                        .. math.floor(Humanoid.MaxHealth)
                })
            else
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Itrapped detected."
                })
            end
        else
            HealthParagraph:Set({
                Title = "Itrapped Health",
                Content = TargetWasDetected
                    and "Itrapped disappeared."
                    or "Waiting for Itrapped..."
            })

            -- Rejoin only if Itrapped was detected and then disappeared.
            if TargetWasDetected and not DefeatHandledLocal then
                DefeatHandledLocal = true
                TargetWasDetected = false

                local CurrentEssence = GetTimeEssence()

                Notify("Itrapped", "Itrapped disappeared.")

                if PreviousEssence ~= nil
                    and CurrentEssence ~= nil
                    and CurrentEssence > PreviousEssence then

                    Notify(
                        "Time Essences",
                        "Essence increased to " .. tostring(CurrentEssence)
                    )
                end

                PreviousEssence = CurrentEssence

                if Flags.AutoRejoin then
                    task.delay(2, AutoRejoin)
                end
            end
        end
    end
end)

