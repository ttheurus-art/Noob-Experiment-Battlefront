-- AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction =
        queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)

    if not QueueFunction then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"))()
        ]])
    end)
end

MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = true,
    Flag = "AutoExecuteTeleport",
    Callback = function(Value)
        AutoExecuteEnabled = Value

        if Value then
            local Success = QueueAutoExecute()

            if not Success then
                Rayfield:Notify({
                    Title = "Auto Execute",
                    Content = "Queue-on-teleport is unavailable.",
                    Duration = 5
                })
            end
        end
    end
})

-- QUEUE ON INITIAL EXECUTION
if AutoExecuteEnabled then
    QueueAutoExecute()
end

-- AUTO PUNCH LOOP
task.spawn(function()
    while task.wait(0.1) do
        if Flags.AutoPunch then
            local Character = Player.Character
            local Punch = Character
                and Character:FindFirstChild("Punch")
            local Event = Punch
                and Punch:FindFirstChild("RemoteEvent")

            if Event and Event:IsA("RemoteEvent") then
                pcall(function()
                    Event:FireServer()
                end)
            end
        end
    end
end)

-- TELEPORT HELPER
local function TeleportTo(Position)
    local Character = Player.Character
        or Player.CharacterAdded:Wait()

    local Root = Character:WaitForChild("HumanoidRootPart")
    Root.CFrame = CFrame.new(Position)
end

-- AUTO MINIGAME LOOP
task.spawn(function()
    while task.wait(0.1) do
        if not Flags.AutoMinigame then
            SequenceStarted = false
            continue
        end

        if not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                task.wait(18)

                if not Flags.AutoMinigame then
                    SequenceStarted = false
                    return
                end

                TeleportTo(Vector3.new(99, -18, 193))

                task.wait(9)

                if not Flags.AutoMinigame then
                    SequenceStarted = false
                    return
                end

                TeleportTo(Vector3.new(85, -16, 59))

                while Flags.AutoMinigame do
                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot = Target
                        and Target:FindFirstChild("HumanoidRootPart")
                    local Humanoid = Target
                        and Target:FindFirstChildOfClass("Humanoid")

                    local Character = Player.Character
                    local Root = Character
                        and Character:FindFirstChild("HumanoidRootPart")

                    if Target and TargetRoot and Humanoid then
                        ItrappedSeen = true

                        if Root then
                            Root.CFrame = TargetRoot.CFrame
                                * CFrame.new(0, 0, 3)

                            Root.AssemblyLinearVelocity = Vector3.zero
                            Root.AssemblyAngularVelocity = Vector3.zero
                        end

                        HealthParagraph:Set({
                            Title = "Itrapped Health",
                            Content = "Health: "
                                .. math.floor(Humanoid.Health)
                                .. " / "
                                .. math.floor(Humanoid.MaxHealth)
                        })
                    else
                        HealthParagraph:Set({
                            Title = "Itrapped Health",
                            Content = "Waiting for Itrapped..."
                        })
                    end

                    task.wait()
                end

                SequenceStarted = false
            end)
        end
    end
end)

-- AUTO REJOIN WHEN ITRAPPED DISAPPEARS
task.spawn(function()
    while task.wait(0.2) do
        if not Flags.AutoRejoin or RejoinStarted then
            continue
        end

        local Target = workspace:FindFirstChild("Itrapped")

        if Target then
            ItrappedSeen = true
        elseif ItrappedSeen then
            task.wait(1.4)

            -- Confirm Itrapped is still missing
            if Flags.AutoRejoin
                and not RejoinStarted
                and not workspace:FindFirstChild("Itrapped") then

                RejoinStarted = true

                pcall(function()
                    TeleportService:Teleport(game.PlaceId, Player)
                end)
            end

            break
        end
    end
end)

-- AUTO REJOIN IF FROZEN TUNDRA IS NOT DETECTED WITHIN 80 SECONDS
task.spawn(function()
    local StartTime = os.clock()
    local FrozenTundraDetected = false

    while os.clock() - StartTime < 80 do
        if not Flags.AutoRejoin or RejoinStarted then
            return
        end

        -- Check Battlefield and descendants for the map name
        local Battlefield = workspace:FindFirstChild("Battlefield")

        if Battlefield then
            if Battlefield.Name == "Frozen Tundra"
                or Battlefield:FindFirstChild("Frozen Tundra", true) then

                FrozenTundraDetected = true
                break
            end
        end

        -- Also check workspace in case the map is a direct child
        if workspace:FindFirstChild("Frozen Tundra") then
            FrozenTundraDetected = true
            break
        end

        task.wait(0.2)
    end

    if FrozenTundraDetected then
        return
    end

    if Flags.AutoRejoin and not RejoinStarted then
        RejoinStarted = true

        pcall(function()
            TeleportService:Teleport(game.PlaceId, Player)
        end)
    end
end)
