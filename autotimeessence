-- FROZEN TUNDRA SCAN: ONE PASS, MAXIMUM 5 SECONDS
task.spawn(function()
    local startedAt = os.clock()

    while IsCurrentInstance()
        and Flags.AutoDetectFrozenTundra
        and not FrozenScanFinished
        and not RejoinStarted
        and os.clock() - startedAt < 5 do

        if workspace:FindFirstChild("Frozen Tundra") then
            FrozenScanFinished = true
            Notify("Frozen Tundra Detected", "Rejoining...", 3)
            RequestRejoin()
            return
        end

        task.wait(0.1)
    end

    FrozenScanFinished = true
end)

