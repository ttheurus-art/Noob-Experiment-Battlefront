-- AUTO MINIGAME TELEPORT SEQUENCE
task.spawn(function()
    while IsCurrentInstance() do
        if RejoinStarted then return end

        if Flags.AutoMinigame and not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                local function SequenceActive()
                    return IsCurrentInstance()
                        and Flags.AutoMinigame
                        and not RejoinStarted
                end

                task.wait(16)

                if not SequenceActive() then
                    SequenceStarted = false
                    return
                end

                -- TP1
                while SequenceActive() do
                    local battlefield = workspace:FindFirstChild("Battlefield")
                    local frozenTundra = workspace:FindFirstChild("Frozen Tundra")

                    if not battlefield and frozenTundra then break end

                    TeleportTo(Vector3.new(99, -18, 193))
                    task.wait(0.2)
                end

                if not SequenceActive() then
                    SequenceStarted = false
                    return
                end

                -- TP2
                while SequenceActive() do
                    local target = workspace:FindFirstChild("Itrapped")
                    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")

                    if targetRoot then break end

                    TeleportTo(Vector3.new(85, -16, 59))
                    task.wait(0.2)
                end

                -- FOLLOW ITRAPPED
                while SequenceActive() do
                    local target = workspace:FindFirstChild("Itrapped")
                    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
                    local root = GetRoot()

                    if not targetRoot or not root then break end

                    pcall(function()
                        root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end)

                    RunService.Heartbeat:Wait()
                end

                SequenceStarted = false
            end)
        end

        task.wait(0.2)
    end
end)

-- ALWAYS FACE ITRAPPED
RunService:BindToRenderStep(
    RenderName,
    Enum.RenderPriority.Character.Value + 1,
    function()
        if not IsCurrentInstance()
            or not Flags.FaceItrapped
            or RejoinStarted then
            return
        end

        local character = GetCharacter()
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local target = workspace:FindFirstChild("Itrapped")
        local targetRoot = target and target:FindFirstChild("HumanoidRootPart")

        if not root or not humanoid or not targetRoot then
            if humanoid then humanoid.AutoRotate = true end
            return
        end

        humanoid.AutoRotate = false

        local myPosition = root.Position
        local targetPosition = targetRoot.Position
        local flatTarget = Vector3.new(
            targetPosition.X,
            myPosition.Y,
            targetPosition.Z
        )

        if (flatTarget - myPosition).Magnitude > 0.01 then
            root.CFrame = CFrame.lookAt(myPosition, flatTarget)
        end
    end
)

