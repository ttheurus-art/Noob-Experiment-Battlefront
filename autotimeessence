local REJOIN_DELAY = 3
local MAX_RETRIES = 5
local JOIN_CHECK_DURATION = 5

local TP1_POSITION = Vector3.new(99, -18, 193)
local TP2_POSITION = Vector3.new(85, -16, 59)

