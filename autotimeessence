
--==================================================
-- AUTO MINIGAME
-- TP 1 + TP 2 + TP 3 PER-FRAME FOLLOW
--==================================================

-- SERVICES
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

-- CONFIG
local Flags = {
    AutoPunch = true,
    AutoMinigame = true,
    AutoRejoin = true,
    AutoExecuteTeleport = true
}

local SequenceStarted = false
local Rejoining = false
local RejoinAttempts = 0
local DefeatHandled = false

local TP_INTERVAL = 0.1
local INITIAL_DELAY = 5
local REJOIN_DELAY = 3
local MAX_RETRIES = 5
local JOIN_CHECK_DURATION = 5

local TP1_POSITION = Vector3.new(99, -18, 193)
local TP2_POSITION = Vector3.new(85, -16, 59)

--==================================================
-- RAYFIELD
--==================================================

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Automation Panel",
    ConfigurationSaving = {
        Enabled = false
    }
})

local MainTab = Window:CreateTab("Main", 4483362458)

local function Notify(Title, Content)
    Rayfield:Notify({
        Title = Title,
        Content = Content,
        Duration = 5
    })
end

local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

--==================================================
-- EXECUTOR QUEUE
--==================================================

local function GetQueueFunction()
    return queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
end

local function QueueAutoExecute()
    local QueueFunction = GetQueueFunction()

    if not QueueFunction then
        Notify(
            "Auto Execute",
            "Queue-on-teleport is unavailable."
        )
        return
    end

    local Success, ErrorMessage = pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
            ))()
        ]])
    end)

    if Success then
        Notify("Auto Execute", "Queued for the next teleport.")
    else
        warn("Queue failed: " .. tostring(ErrorMessage))
    end
end

--==================================================
-- TELEPORT HELPER
--==================================================

local function TeleportTo(Position)
    local Character = Player.Character
    local Root = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return false
    end

    local Success = pcall(function()
        Root.CFrame = CFrame.new(Position)
    end)

    return Success
end

--==================================================
-- REJOIN
--==================================================

local function AutoRejoin()
    if not Flags.AutoRejoin or Rejoining then
        return
    end

    Rejoining = true

    task.spawn(function()
        while Flags.AutoRejoin
            and RejoinAttempts < MAX_RETRIES do

            RejoinAttempts += 1

            Notify(
                "Auto Rejoin",
                "Rejoining... Attempt "
                    .. RejoinAttempts
                    .. "/"
                    .. MAX_RETRIES
            )

            if Flags.AutoExecuteTeleport then
                QueueAutoExecute()
            end

            task.wait(REJOIN_DELAY)

            local Success, ErrorMessage = pcall(function()
                TeleportService:Teleport(
                    game.PlaceId,
                    Player
                )
            end)

            if not Success then
                warn(
                    "Rejoin failed: "
                        .. tostring(ErrorMessage)
                )
            end

            task.wait(5)
        end

        Rejoining = false
    end)
end

TeleportService.TeleportInitFailed:Connect(function(
    TeleportPlayer,
    TeleportResult,
    ErrorMessage
)
    if TeleportPlayer ~= Player then
        return
    end

    warn(
        "Teleport failed: "
            .. tostring(TeleportResult)
            .. " | "
            .. tostring(ErrorMessage)
    )

    if Flags.AutoRejoin then
        Rejoining = false
        task.delay(1, AutoRejoin)
    end
end)

