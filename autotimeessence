-- CHARACTER HELPERS
local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function GetEssences()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essences = Leaderstats
        and Leaderstats:FindFirstChild("Time Essences")

    return Essences and Essences.Value or nil
end

local function TeleportTo(Position)
    local Root = GetRoot()
    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- QUEUE AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction

    pcall(function()
        if type(queue_on_teleport) == "function" then
            QueueFunction = queue_on_teleport
        end
    end)

    if not QueueFunction then
        pcall(function()
            if type(syn) == "table"
                and type(syn.queue_on_teleport) == "function" then
                QueueFunction = syn.queue_on_teleport
            end
        end)
    end

    if not QueueFunction then
        pcall(function()
            if type(fluxus) == "table"
                and type(fluxus.queue_on_teleport) == "function" then
                QueueFunction = fluxus.queue_on_teleport
            end
        end)
    end

    if not QueueFunction then
        warn("Auto Execute: queue API unavailable.")
        return false
    end

    local QueueSuccess, QueueError = pcall(function()
        QueueFunction([[
            task.wait(2)

            local Success, ErrorMessage = pcall(function()
                loadstring(game:HttpGet(
                    "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
                ))()
            end)

            if not Success then
                warn("Auto Execute failed:", tostring(ErrorMessage))
            end
        ]])
    end)

    if not QueueSuccess then
        warn("Auto Execute queue failed:", tostring(QueueError))
        return false
    end

    return true
end

-- STOP AUTOMATION BEFORE REJOIN
local function StopAutomationForRejoin()
    Flags.AutoPunch = false
    Flags.AutoMinigame = false
    Flags.FaceItrapped = false

    SequenceStarted = false

    local Humanoid = GetHumanoid()
    if Humanoid then
        Humanoid.AutoRotate = true
    end
end

-- REJOIN SYSTEM
local AttemptTeleport

local function ScheduleTeleportRetry()
    if not IsCurrentInstance()
        or not RejoinStarted
        or TeleportRetryScheduled then
        return
    end

    if TeleportAttempts >= MaxTeleportAttempts then
        warn("Auto Rejoin: maximum attempts reached.")
        RejoinStarted = false
        TeleportRetryScheduled = false
        return
    end

    TeleportRetryScheduled = true

    task.delay(2, function()
        if not IsCurrentInstance() or not RejoinStarted then
            TeleportRetryScheduled = false
            return
        end

        TeleportRetryScheduled = false
        AttemptTeleport()
    end)
end

AttemptTeleport = function()
    if not IsCurrentInstance() or not RejoinStarted then
        return
    end

    if TeleportAttempts >= MaxTeleportAttempts then
        warn("Auto Rejoin: maximum attempts reached.")
        RejoinStarted = false
        TeleportRetryScheduled = false
        return
    end

    TeleportAttempts += 1

    local AttemptNumber = TeleportAttempts
    local DelayTime = math.min(AttemptNumber * 5, 30)

    task.spawn(function()
        task.wait(DelayTime)

        if not IsCurrentInstance() or not RejoinStarted then
            return
        end

        local Success, ErrorMessage = pcall(function()
            -- Client/executor support varies.
            TeleportService:Teleport(game.PlaceId)
        end)

        if not Success then
            warn(
                "Rejoin attempt " .. AttemptNumber .. " failed:",
                tostring(ErrorMessage)
            )

            ScheduleTeleportRetry()
        end
    end)
end

TrackConnection(TeleportService.TeleportInitFailed:Connect(
    function(FailedPlayer, TeleportResult, ErrorMessage)
        if FailedPlayer ~= Player
            or not RejoinStarted
            or not IsCurrentInstance() then
            return
        end

        warn(
            "Teleport failed:",
            tostring(TeleportResult),
            tostring(ErrorMessage)
        )

        ScheduleTeleportRetry()
    end
))

local function RequestRejoin()
    if RejoinStarted or not IsCurrentInstance() then
        return
    end

    RejoinStarted = true
    TeleportAttempts = 0
    TeleportRetryScheduled = false

    StopAutomationForRejoin()

    if Flags.AutoExecute then
        QueueAutoExecute()
    end

    task.wait(0.5)

    if IsCurrentInstance() and RejoinStarted then
        AttemptTeleport()
    end
end

