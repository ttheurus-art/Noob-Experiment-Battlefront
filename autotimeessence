-- SERVICES
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local Player = Players.LocalPlayer

-- CONFIG
local Flags = {
    AutoPunch = true,
    AutoMinigame = true,
    AutoRejoin = true
}

local SequenceStarted = false
local ItrappedSeen = false
local RejoinStarted = false

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Automation Panel",
    ConfigurationSaving = {
        Enabled = false
    }
})

local MainTab = Window:CreateTab("Main", 4483362458)

-- NOTIFICATION HELPER
local function Notify(Title, Content)
    Rayfield:Notify({
        Title = Title,
        Content = Content,
        Duration = 5
    })
end

-- HEALTH PARAGRAPH
local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

-- AUTO PUNCH
MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        Flags.AutoPunch = Value
    end
})

-- AUTO MINIGAME
MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",
    Callback = function(Value)
        Flags.AutoMinigame = Value

        if Value then
            SequenceStarted = false
        end
    end
})

-- AUTO REJOIN
MainTab:CreateToggle({
    Name = "Auto Rejoin",
    CurrentValue = true,
    Flag = "AutoRejoin",
    Callback = function(Value)
        Flags.AutoRejoin = Value
    end
})

-- AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction =
        queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)

    if not QueueFunction then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"))()
        ]])
    end)
end

MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = true,
    Flag = "AutoExecuteTeleport",
    Callback = function(Value)
        if Value then
            local Success = QueueAutoExecute()

            if not Success then
                Notify(
                    "Auto Execute",
                    "Queue-on-teleport is unavailable."
                )
            end
        end
    end
})

-- QUEUE ON INITIAL EXECUTION
QueueAutoExecute()

-- AUTO PUNCH LOOP
task.spawn(function()
    while task.wait(0.1) do
        if Flags.AutoPunch then
            local Character = Player.Character
            local Punch = Character
                and Character:FindFirstChild("Punch")
            local Event = Punch
                and Punch:FindFirstChild("RemoteEvent")

            if Event and Event:IsA("RemoteEvent") then
                pcall(function()
                    Event:FireServer()
                end)
            end
        end
    end
end)

-- TELEPORT HELPER
local function TeleportTo(Position)
    local Character = Player.Character
        or Player.CharacterAdded:Wait()

    local Root = Character:WaitForChild("HumanoidRootPart")
    Root.CFrame = CFrame.new(Position)
end

-- AUTO MINIGAME LOOP
task.spawn(function()
    while task.wait(0.1) do
        if not Flags.AutoMinigame then
            SequenceStarted = false
            continue
        end

        if not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                task.wait(18)

                if not Flags.AutoMinigame then
                    SequenceStarted = false
                    return
                end

                TeleportTo(Vector3.new(99, -18, 193))

                task.wait(9)

                if not Flags.AutoMinigame then
                    SequenceStarted = false
                    return
                end

                TeleportTo(Vector3.new(85, -16, 59))

                while Flags.AutoMinigame do
                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot = Target
                        and Target:FindFirstChild("HumanoidRootPart")
                    local Humanoid = Target
                        and Target:FindFirstChildOfClass("Humanoid")

                    local Character = Player.Character
                    local Root = Character
                        and Character:FindFirstChild("HumanoidRootPart")

                    if Target and TargetRoot and Humanoid then
                        ItrappedSeen = true

                        if Root then
                            Root.CFrame = TargetRoot.CFrame
                                * CFrame.new(0, 0, 3)

                            Root.AssemblyLinearVelocity = Vector3.zero
                            Root.AssemblyAngularVelocity = Vector3.zero
                        end

                        HealthParagraph:Set({
                            Title = "Itrapped Health",
                            Content = "Health: "
                                .. math.floor(Humanoid.Health)
                                .. " / "
                                .. math.floor(Humanoid.MaxHealth)
                        })
                    else
                        HealthParagraph:Set({
                            Title = "Itrapped Health",
                            Content = "Waiting for Itrapped..."
                        })
                    end

                    task.wait()
                end

                SequenceStarted = false
            end)
        end
    end
end)

-- TIME ESSENCE READER
local function GetTimeEssence()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essence = Leaderstats
        and Leaderstats:FindFirstChild("Time Essences")

    if Essence and (
        Essence:IsA("IntValue")
        or Essence:IsA("NumberValue")
    ) then
        return Essence.Value
    end

    return nil
end

-- AUTO REJOIN WHEN ITRAPPED DISAPPEARS
task.spawn(function()
    while task.wait(0.2) do
        if not Flags.AutoRejoin or RejoinStarted then
            continue
        end

        local Target = workspace:FindFirstChild("Itrapped")

        if Target then
            ItrappedSeen = true
        elseif ItrappedSeen then
            -- Capture essence count before checking reward
            local EssenceBefore = GetTimeEssence()

            Notify(
                "Minigame",
                "Itrapped Has Been Defeated"
            )

            task.wait(1.4)

            if not workspace:FindFirstChild("Itrapped") then
                -- Allow leaderboard to update
                task.wait(0.5)

                local EssenceAfter = GetTimeEssence()

                if EssenceBefore ~= nil
                    and EssenceAfter ~= nil then

                    if EssenceAfter > EssenceBefore then
                        Notify(
                            "Time Essence",
                            "You Got Time Essence! (25% drop)"
                        )
                    else
                        Notify(
                            "Time Essence",
                            "You Don't Get Time Essence, GL Next Time"
                        )
                    end
                else
                    Notify(
                        "Time Essence",
                        "Couldn't read Time Essences from leaderboard."
                    )
                end

                RejoinStarted = true

                pcall(function()
                    TeleportService:Teleport(
                        game.PlaceId,
                        Player
                    )
                end)

                break
            end
        end
    end
end)

-- MAP DETECTION
task.spawn(function()
    local StartTime = os.clock()

    local function HasBattlefield()
        return workspace:FindFirstChild("Battlefield") ~= nil
    end

    local function HasFrozenTundra()
        return workspace:FindFirstChild("Frozen Tundra") ~= nil
    end

    -- Frozen Tundra exists at startup without Battlefield
    if HasFrozenTundra() and not HasBattlefield() then
        Notify(
            "Auto Rejoin",
            "The Server Has Been Collected Before"
        )

        if Flags.AutoRejoin and not RejoinStarted then
            RejoinStarted = true

            pcall(function()
                TeleportService:Teleport(
                    game.PlaceId,
                    Player
                )
            end)
        end

        return
    end

    -- Wait up to 5 seconds for Battlefield
    while os.clock() - StartTime < 5 do
        if not Flags.AutoRejoin or RejoinStarted then
            return
        end

        if HasBattlefield() then
            -- Battlefield detected: wait for Frozen Tundra
            while Flags.AutoRejoin and not RejoinStarted do
                if HasFrozenTundra() then
                    return
                end

                task.wait(0.2)
            end

            return
        end

        if HasFrozenTundra() then
            Notify(
                "Auto Rejoin",
                "The Server Has Been Collected Before"
            )

            if not RejoinStarted then
                RejoinStarted = true

                pcall(function()
                    TeleportService:Teleport(
                        game.PlaceId,
                        Player
                    )
                end)
            end

            return
        end

        task.wait(0.2)
    end

    -- Rejoin if neither map appeared within 5 seconds
    if not HasBattlefield()
        and not HasFrozenTundra()
        and Flags.AutoRejoin
        and not RejoinStarted then

        RejoinStarted = true

        pcall(function()
            TeleportService:Teleport(
                game.PlaceId,
                Player
            )
        end)
    end
end)
