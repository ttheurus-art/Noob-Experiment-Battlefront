-- AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction =
        queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)

    if type(QueueFunction) ~= "function" then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
            ))()
        ]])
    end)
end

MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = true,
    Flag = "AutoExecuteTeleport",
    Callback = function(Value)
        Flags.AutoExecuteTeleport = Value

        if Value then
            if not QueueAutoExecute() then
                Notify(
                    "Auto Execute",
                    "Queue-on-teleport is unavailable."
                )
            end
        end
    end
})

if Flags.AutoExecuteTeleport then
    QueueAutoExecute()
end

-- AUTO REJOIN SYSTEM
local function AutoRejoin()
    if not Flags.AutoRejoin or Rejoining then
        return
    end

    Rejoining = true
    RejoinAttempts = 0

    task.spawn(function()
        while Flags.AutoRejoin
            and RejoinAttempts < MAX_RETRIES do

            RejoinAttempts += 1

            Notify(
                "Auto Rejoin",
                "Rejoining... Attempt "
                    .. RejoinAttempts
                    .. "/"
                    .. MAX_RETRIES
            )

            task.wait(REJOIN_DELAY)

            if not Flags.AutoRejoin then
                break
            end

            local Success, ErrorMessage = pcall(function()
                TeleportService:Teleport(
                    game.PlaceId,
                    Player
                )
            end)

            if Success then
                Notify(
                    "Auto Rejoin",
                    "Teleport request sent."
                )
                return
            else
                Notify(
                    "Teleport Error",
                    tostring(ErrorMessage)
                )
            end

            task.wait(2)
        end

        Rejoining = false

        if Flags.AutoRejoin then
            Notify(
                "Auto Rejoin",
                "Maximum retry attempts reached."
            )
        end
    end)
end

TeleportService.TeleportInitFailed:Connect(
    function(TeleportPlayer, TeleportResult, ErrorMessage)
        if TeleportPlayer ~= Player then
            return
        end

        if not Flags.AutoRejoin then
            Rejoining = false
            return
        end

        Rejoining = false

        Notify(
            "Teleport Failed",
            tostring(TeleportResult)
                .. ": "
                .. tostring(ErrorMessage)
        )

        task.delay(2, AutoRejoin)
    end
)

-- TELEPORT HELPER
local function TeleportTo(Position)
    local Character = Player.Character
        or Player.CharacterAdded:Wait()

    local Root = Character:WaitForChild(
        "HumanoidRootPart",
        5
    )

    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
    end)
end

