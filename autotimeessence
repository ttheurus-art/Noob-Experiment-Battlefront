-- CHARACTER HELPERS
local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function GetEssences()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essences = Leaderstats
        and Leaderstats:FindFirstChild("Time Essences")

    return Essences and Essences.Value or nil
end

local function TeleportTo(Position)
    local Root = GetRoot()
    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- QUEUE AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction

    pcall(function()
        if type(queue_on_teleport) == "function" then
            QueueFunction = queue_on_teleport
        elseif syn and type(syn.queue_on_teleport) == "function" then
            QueueFunction = syn.queue_on_teleport
        elseif fluxus
            and type(fluxus.queue_on_teleport) == "function" then
            QueueFunction = fluxus.queue_on_teleport
        end
    end)

    if not QueueFunction then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
            ))()
        ]])
    end)
end

-- NORMAL AUTO REJOIN
local function RequestRejoin(ShouldAutoExecute)
    if RejoinStarted or not IsCurrentInstance() then
        return
    end

    RejoinStarted = true

    Flags.AutoPunch = false
    Flags.AutoMinigame = false
    Flags.FaceItrapped = false

    if ShouldAutoExecute and Flags.AutoExecute then
        QueueAutoExecute()
    end

    task.spawn(function()
        for Attempt = 1, 5 do
            if not IsCurrentInstance() then
                return
            end

            local Success = pcall(function()
                TeleportService:Teleport(game.PlaceId, Player)
            end)

            if Success then
                task.wait(8)
            else
                task.wait(2)
            end

            if not IsCurrentInstance() then
                return
            end
        end

        warn("Auto Rejoin: teleport attempts finished.")
    end)
end

