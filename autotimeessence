-- FROZEN TUNDRA SCAN: ONCE, MAXIMUM 5 SECONDS
task.spawn(function()
    local StartTime = os.clock()

    while IsCurrentInstance()
        and Flags.AutoDetectFrozenTundra
        and not FrozenScanFinished
        and not RejoinStarted
        and os.clock() - StartTime < 5 do

        if workspace:FindFirstChild("Frozen Tundra") then
            FrozenScanFinished = true
            FrozenRejoinTriggered = true
            InitialRejoinTriggered = true

            StopAutomationForRejoin()

            Rayfield:Notify({
                Title = "Frozen Tundra Detected",
                Content = "Rejoining...",
                Duration = 2
            })

            RequestRejoin()
            return
        end

        task.wait(0.1)
    end

    FrozenScanFinished = true
end)

