(
                game.-- SERVICES
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local Player = Players.LocalPlayer

-- CONFIG
local Flags = {
    AutoPunch = true,
    AutoMinigame = true,
    AutoRejoin = true,
    AutoExecuteTeleport = true
}

local SequenceStarted = false
local ItrappedSeen = false
local RejoinStarted = false

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Automation Panel",
    ConfigurationSaving = {
        Enabled = false
    }
})

local MainTab = Window:CreateTab("Main", 4483362458)

-- NOTIFICATION
local function Notify(Title, Content)
    Rayfield:Notify({
        Title = Title,
        Content = Content,
        Duration = 5
    })
end

-- HEALTH DISPLAY
local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

-- AUTO PUNCH
MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        Flags.AutoPunch = Value
    end
})

-- AUTO MINIGAME
MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",
    Callback = function(Value)
        Flags.AutoMinigame = Value
    end
})

-- AUTO REJOIN
MainTab:CreateToggle({
    Name = "Auto Rejoin",
    CurrentValue = true,
    Flag = "AutoRejoin",
    Callback = function(Value)
        Flags.AutoRejoin = Value
    end
})

-- AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction =
        queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)

    if type(QueueFunction) ~= "function" then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"))()
        ]])
    end)
end

MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = true,
    Flag = "AutoExecuteTeleport",
    Callback = function(Value)
        Flags.AutoExecuteTeleport = Value

        if Value then
            local Success = QueueAutoExecute()

            if not Success then
                Notify(
                    "Auto Execute",
                    "Queue-on-teleport is unavailable."
                )
            end
        end
    end
})

if Flags.AutoExecuteTeleport then
    QueueAutoExecute()
end

-- TELEPORT HELPER
local function TeleportTo(Position)
    local Character = Player.Character
        or Player.CharacterAdded:Wait()

    local Root = Character:WaitForChild("HumanoidRootPart", 5)

    if not Root then
        return false
    end

    local Success = pcall(function()
        Root.CFrame = CFrame.new(Position)
    end)

    return Success
end

-- AUTO PUNCH LOOP
task.spawn(function()
    while task.wait(0.1) do
        if Flags.AutoPunch then
            local Character = Player.Character
            local Punch = Character
                and Character:FindFirstChild("Punch")
            local Event = Punch
                and Punch:FindFirstChild("RemoteEvent")

            if Event and Event:IsA("RemoteEvent") then
                pcall(function()
                    Event:FireServer()
                end)
            end
        end
    end
end)

-- AUTO MINIGAME / TP RETRY
task.spawn(function()
    while task.wait(0.2) do
        if Flags.AutoMinigame and not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                -- Initial wait before first TP
                task.wait(18)

                if not Flags.AutoMinigame then
                    SequenceStarted = false
                    return
                end

                local MaxAttempts = 3
                local Success = false

                for Attempt = 1, MaxAttempts do
                    if not Flags.AutoMinigame then
                        break
                    end

                    -- First TP
                    TeleportTo(Vector3.new(99, -18, 193))

                    -- Wait 7 seconds for the map to change
                    task.wait(7)

                    if not Flags.AutoMinigame then
                        break
                    end

                    -- Frozen Tundra means the transition succeeded
                    if workspace:FindFirstChild("Frozen Tundra") then
                        Success = true
                        break
                    end

                    -- Battlefield still exists: retry the TP sequence
                    if workspace:FindFirstChild("Battlefield") then
                        -- Second TP
                        TeleportTo(Vector3.new(85, -16, 59))

                        task.wait(7)

                        if workspace:FindFirstChild("Frozen Tundra") then
                            Success = true
                            break
                        end
                    else
                        -- Check whether the map changed during the attempt
                        if workspace:FindFirstChild("Frozen Tundra") then
                            Success = true
                        end

                        break
                    end
                end

                if not Success
                    and Flags.AutoRejoin
                    and not RejoinStarted then

                    Notify(
                        "Auto Minigame",
                        "The Game Or The Tp Mechanism Is Not Working"
                    )

                    RejoinStarted = true
                    task.wait(1)

                    pcall(function()
                        TeleportService:Teleport(
                            game.PlaceId,
                            Player
                        )
                    end)
                end

                SequenceStarted = false
            end)
        end
    end
end)

-- TIME ESSENCE READER
local function GetTimeEssence()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essence = Leaderstats
        and Leaderstats:FindFirstChild("Time Essences")

    if Essence and (
        Essence:IsA("IntValue")
        or Essence:IsA("NumberValue")
    ) then
        return Essence.Value
    end

    return nil
end

-- ITRAPPED DEFEAT DETECTION
task.spawn(function()
    local LastEssenceValue = GetTimeEssence()

    while task.wait(0.2) do
        local Target = workspace:FindFirstChild("Itrapped")

        if Target then
            ItrappedSeen = true

            -- Keep the most recent essence count while the target exists
            local CurrentEssence = GetTimeEssence()

            if CurrentEssence ~= nil then
                LastEssenceValue = CurrentEssence
            end

            local Humanoid = Target:FindFirstChildOfClass("Humanoid")

            if Humanoid then
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Health: "
                        .. math.floor(Humanoid.Health)
                        .. " / "
                        .. math.floor(Humanoid.MaxHealth)
                })
            end
        elseif ItrappedSeen then
            ItrappedSeen = false

            Notify(
                "Minigame",
                "Itrapped Has Been Defeated"
            )

            task.wait(1.4)

            if not workspace:FindFirstChild("Itrapped") then
                -- Give the leaderboard time to update
                task.wait(0.5)

                local EssenceAfter = GetTimeEssence()

                if LastEssenceValue ~= nil and EssenceAfter ~= nil then
                    if EssenceAfter > LastEssenceValue then
                        Notify(
                            "Time Essence",
                            "You Got Time Essence! (25% drop)"
                        )
                    else
                        Notify(
                            "Time Essence",
                            "You Don't Get Time Essence, GL Next Time"
                        )
                    end
                else
                    Notify(
                        "Time Essence",
                        "Couldn't read Time Essences from leaderboard."
                    )
                end

                if Flags.AutoRejoin and not RejoinStarted then
                    RejoinStarted = true
                    task.wait(1)

                    pcall(function()
                        TeleportService:Teleport(
                            game.PlaceId,
                            Player
                        )
                    end)
                end
            end
        end
    end
end)

-- MAP DETECTION
task.spawn(function()
    local StartTime = os.clock()

    local function HasBattlefield()
        return workspace:FindFirstChild("Battlefield") ~= nil
    end

    local function HasFrozenTundra()
        return workspace:FindFirstChild("Frozen Tundra") ~= nil
    end

    -- Frozen Tundra exists immediately, with no Battlefield
    if HasFrozenTundra() and not HasBattlefield() then
        Notify(
            "Auto Rejoin",
            "The Server Has Been Collected Before"
        )

        if Flags.AutoRejoin and not RejoinStarted then
            RejoinStarted = true

            pcall(function()
                TeleportService:Teleport(
                    game.PlaceId,
                    Player
                )
            end)
        end

        return
    end

    -- Wait up to 5 seconds for Battlefield
    while os.clock() - StartTime < 5 do
        if RejoinStarted or not Flags.AutoRejoin then
            return
        end

        if HasBattlefield() then
            -- Battlefield appeared; do not rejoin during transition
            while Flags.AutoRejoin and not RejoinStarted do
                if HasFrozenTundra() then
                    return
                end

                task.wait(0.2)
            end

            return
        end

        if HasFrozenTundra() then
            Notify(
                "Auto Rejoin",
                "The Server Has Been Collected Before"
            )

            if not RejoinStarted then
                RejoinStarted = true

                pcall(function()
                    TeleportService:Teleport(
                        game.PlaceId,
                        Player
                    )
                end)
            end

            return
        end

        task.wait(0.2)
    end

    -- Neither map appeared within 5 seconds
    if not HasBattlefield()
        and not HasFrozenTundra()
        and Flags.AutoRejoin
        and not RejoinStarted then

        RejoinStarted = true

        pcall(function()
            TeleportService:Teleport(
                game.PlaceId,
                Player
            )
        end)
    end
end)
