-- ALWAYS FACE ITRAPPED
RunService:BindToRenderStep(
    RenderName,
    Enum.RenderPriority.Character.Value + 1,
    function()
        if not IsCurrentInstance()
            or not Flags.FaceItrapped
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        local Character =
            workspace:FindFirstChild(Player.Name) or GetCharacter()

        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")

        local Target = workspace:FindFirstChild("Itrapped")
        local TargetRoot = Target
            and Target:FindFirstChild("HumanoidRootPart")

        if not Root or not Humanoid or not TargetRoot then
            if Humanoid then
                Humanoid.AutoRotate = true
            end
            return
        end

        Humanoid.AutoRotate = false

        local MyPosition = Root.Position
        local TargetPosition = TargetRoot.Position

        local FlatTarget = Vector3.new(
            TargetPosition.X,
            MyPosition.Y,
            TargetPosition.Z
        )

        if (FlatTarget - MyPosition).Magnitude > 0.01 then
            Root.CFrame = CFrame.lookAt(MyPosition, FlatTarget)
        end
    end
)

