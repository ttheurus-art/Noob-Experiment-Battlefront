-- CLEANUP PREVIOUS INSTANCE
local Env
pcall(function()
    if type(getgenv) == "function" then
        Env = getgenv()
    end
end)

if Env and type(Env.AutoMinigameCleanup) == "function" then
    pcall(Env.AutoMinigameCleanup)
end

local Running = true
local RenderName = "AutoMinigameFace_" .. Player.UserId
local Connections = {}

local function IsCurrentInstance()
    return Running and (not Env or Env.AutoMinigameRunning == true)
end

local function TrackConnection(connection)
    table.insert(Connections, connection)
    return connection
end

local function Cleanup()
    if not Running then return end
    Running = false

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(Connections)

    pcall(function()
        RunService:UnbindFromRenderStep(RenderName)
    end)

    if Env and Env.AutoMinigameCleanup == Cleanup then
        Env.AutoMinigameRunning = false
        Env.AutoMinigameCleanup = nil
    end
end

if Env then
    Env.AutoMinigameRunning = true
    Env.AutoMinigameCleanup = Cleanup
end

