        Env = getgenv()
    end
end)

if Env then
    if Env.AutoMinigameCleanup then
        pcall(Env.AutoMinigameCleanup)
    end

    Env.AutoMinigameRunning = false
end

local Running = true
local RenderName = "AutoMinigameFace_" .. Player.UserId

local function Cleanup()
    Running = false

    pcall(function()
        RunService:UnbindFromRenderStep(RenderName)
    end)
end

if Env then
    Env.AutoMinigameRunning = true
    Env.AutoMinigameCleanup = Cleanup
end

local function IsCurrentInstance()
    return Running and (
        not Env or Env.AutoMinigameRunning == true
    )
end

