--==================================================
-- TELEPORT HELPER
--==================================================

local function TeleportTo(Position)
    local Character = Player.Character
    local Root = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
    end)
end

--==================================================
-- AUTO EXECUTE
--==================================================

local function GetQueueFunction()
    return queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
end

local function QueueAutoExecute()
    local QueueFunction = GetQueueFunction()

    if not QueueFunction then
        Notify("Auto Execute", "Queue function unavailable.")
        return
    end

    local Success, ErrorMessage = pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
            ))()
        ]])
    end)

    if not Success then
        warn("Auto Execute failed: " .. tostring(ErrorMessage))
    end
end

