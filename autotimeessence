--==================================================
-- AUTO PUNCH LOOP
--==================================================

task.spawn(function()
    while task.wait(0.1) do
        if not Flags.AutoPunch then
            continue
        end

        local Character = Player.Character
        local Punch = Character
            and Character:FindFirstChild("Punch")

        local Remote = Punch
            and Punch:FindFirstChild("RemoteEvent")

        if Remote and Remote:IsA("RemoteEvent") then
            pcall(function()
                Remote:FireServer()
            end)
        end
    end
end)

--==================================================
-- TP 1 + TP 2 SEQUENCE
--==================================================

task.spawn(function()
    while task.wait(0.1) do
        if not Flags.AutoMinigame or SequenceStarted then
            continue
        end

        SequenceStarted = true

        task.spawn(function()
            task.wait(INITIAL_DELAY)

            if not Flags.AutoMinigame then
                SequenceStarted = false
                return
            end

            -- TP 1: STOP WHEN FROZEN TUNDRA APPEARS
            while Flags.AutoMinigame do
                if workspace:FindFirstChild("Frozen Tundra") then
                    break
                end

                TeleportTo(TP1_POSITION)
                task.wait(TP_INTERVAL)
            end

            if not Flags.AutoMinigame then
                SequenceStarted = false
                return
            end

            -- TP 2: STOP WHEN ITRAPPED APPEARS
            while Flags.AutoMinigame do
                if workspace:FindFirstChild("Itrapped") then
                    break
                end

                TeleportTo(TP2_POSITION)
                task.wait(TP_INTERVAL)
            end

            SequenceStarted = false
        end)
    end
end)

--==================================================
-- TP 3: FOLLOW ITRAPPED EVERY FRAME
--==================================================

RunService.Heartbeat:Connect(function()
    if not Flags.AutoMinigame then
        return
    end

    local Target = workspace:FindFirstChild("Itrapped")
    if not Target then
        return
    end

    local TargetRoot =
        Target:FindFirstChild("HumanoidRootPart")
        or Target.PrimaryPart

    if not TargetRoot then
        return
    end

    local Character = Player.Character
    local PlayerRoot = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not PlayerRoot then
        return
    end

    -- Continuously teleport to Itrapped's position.
    pcall(function()
        PlayerRoot.CFrame = TargetRoot.CFrame
    end)
end)

--==================================================
-- INITIAL JOIN CHECK
--==================================================

task.spawn(function()
    task.wait(1)

    if not Flags.AutoRejoin then
        return
    end

    local FrozenTundra = workspace:FindFirstChild("Frozen Tundra")
    local Battlefield = workspace:FindFirstChild("Battlefield")

    if not Battlefield and FrozenTundra then
        local StartTime = os.clock()
        local BattlefieldFound = false

        while os.clock() - StartTime < JOIN_CHECK_DURATION do
            if workspace:FindFirstChild("Battlefield") then
                BattlefieldFound = true
                break
            end

            task.wait(0.1)
        end

        if not BattlefieldFound and Flags.AutoRejoin then
            AutoRejoin()
        end
    end
end)

--==================================================
-- ITRAPPED HEALTH + DEFEAT MONITOR
--==================================================

task.spawn(function()
    local PreviousEssence = nil

    local function GetTimeEssence()
        local Leaderstats = Player:FindFirstChild("leaderstats")
        local Essence = Leaderstats
            and Leaderstats:FindFirstChild("Time Essences")

        if Essence
            and (Essence:IsA("IntValue")
                or Essence:IsA("NumberValue")) then
            return Essence.Value
        end

        return nil
    end

    PreviousEssence = GetTimeEssence()

    while task.wait(0.2) do
        local Target = workspace:FindFirstChild("Itrapped")

        if Target then
            DefeatHandled = false

            local Humanoid = Target:FindFirstChildOfClass("Humanoid")

            if Humanoid then
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Health: "
                        .. math.floor(Humanoid.Health)
                        .. " / "
                        .. math.floor(Humanoid.MaxHealth)
                })
            else
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Itrapped detected."
                })
            end
        else
            HealthParagraph:Set({
                Title = "Itrapped Health",
                Content = "Waiting for Itrapped..."
            })

            if not DefeatHandled then
                DefeatHandled = true

                local CurrentEssence = GetTimeEssence()

                Notify(
                    "Itrapped",
                    "Itrapped is no longer detected."
                )

                if PreviousEssence ~= nil
                    and CurrentEssence ~= nil
                    and CurrentEssence > PreviousEssence then

                    Notify(
                        "Time Essences",
                        "Essence increased to "
                            .. tostring(CurrentEssence)
                    )
                end

                PreviousEssence = CurrentEssence

                if Flags.AutoRejoin then
                    task.delay(2, AutoRejoin)
                end
            end
        end
    end
end)

