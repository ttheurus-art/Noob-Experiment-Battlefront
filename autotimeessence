-- HEALTH / DEFEAT MONITOR
task.spawn(function()
    while IsCurrentInstance() do
        if InitialRejoinTriggered or RejoinStarted then
            return
        end

        local Target = workspace:FindFirstChild("Itrapped")
        local Humanoid = Target
            and Target:FindFirstChildOfClass("Humanoid")

        if Target then
            ItrappedSeen = true

            if Humanoid then
                pcall(function()
                    HealthParagraph:Set({
                        Title = "Itrapped Health",
                        Content = string.format(
                            "Health: %d / %d",
                            math.floor(Humanoid.Health),
                            math.floor(Humanoid.MaxHealth)
                        )
                    })
                end)
            end
        elseif ItrappedSeen then
            ItrappedSeen = false

            pcall(function()
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Itrapped disappeared. Rejoining in 1.7 seconds..."
                })
            end)

            task.wait(1.7)

            if not IsCurrentInstance()
                or InitialRejoinTriggered
                or RejoinStarted then
                return
            end

            if Flags.AutoRejoin then
                RequestRejoin()
                return
            else
                pcall(function()
                    HealthParagraph:Set({
                        Title = "Itrapped Health",
                        Content = "Itrapped disappeared. Auto Rejoin is OFF."
                    })
                end)
            end
        end

        task.wait(0.2)
    end
end)

-- AUTO MINIGAME TELEPORT SEQUENCE
task.spawn(function()
    while IsCurrentInstance() do
        if InitialRejoinTriggered or RejoinStarted then
            return
        end

        if Flags.AutoMinigame and not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                task.wait(16)

                if not IsCurrentInstance()
                    or not Flags.AutoMinigame
                    or RejoinStarted
                    or InitialRejoinTriggered then
                    SequenceStarted = false
                    return
                end

                -- TP1
                while IsCurrentInstance()
                    and Flags.AutoMinigame
                    and not RejoinStarted
                    and not InitialRejoinTriggered do

                    local Battlefield = workspace:FindFirstChild("Battlefield")
                    local FrozenTundra = workspace:FindFirstChild("Frozen Tundra")

                    if not Battlefield and FrozenTundra then
                        break
                    end

                    TeleportTo(Vector3.new(99, -18, 193))
                    task.wait(0.2)
                end

                if not IsCurrentInstance()
                    or not Flags.AutoMinigame
                    or RejoinStarted
                    or InitialRejoinTriggered then
                    SequenceStarted = false
                    return
                end

                -- TP2
                while IsCurrentInstance()
                    and Flags.AutoMinigame
                    and not RejoinStarted
                    and not InitialRejoinTriggered do

                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot = Target
                        and Target:FindFirstChild("HumanoidRootPart")

                    if TargetRoot then
                        break
                    end

                    TeleportTo(Vector3.new(85, -16, 59))
                    task.wait(0.2)
                end

                -- FOLLOW ITRAPPED
                while IsCurrentInstance()
                    and Flags.AutoMinigame
                    and not RejoinStarted
                    and not InitialRejoinTriggered do

                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot = Target
                        and Target:FindFirstChild("HumanoidRootPart")

                    local Root = GetRoot()

                    if not TargetRoot or not Root then
                        break
                    end

                    pcall(function()
                        Root.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, 3)
                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end)

                    RunService.Heartbeat:Wait()
                end

                SequenceStarted = false
            end)
        end

        task.wait(0.2)
    end
end)

-- ALWAYS FACE ITRAPPED
RunService:BindToRenderStep(
    RenderName,
    Enum.RenderPriority.Character.Value + 1,
    function()
        if not IsCurrentInstance()
            or not Flags.FaceItrapped
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        local Character = GetCharacter()
        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")

        local Target = workspace:FindFirstChild("Itrapped")
        local TargetRoot = Target
            and Target:FindFirstChild("HumanoidRootPart")

        if not Root or not Humanoid or not TargetRoot then
            if Humanoid then
                Humanoid.AutoRotate = true
            end
            return
        end

        Humanoid.AutoRotate = false

        local MyPosition = Root.Position
        local TargetPosition = TargetRoot.Position

        local FlatTarget = Vector3.new(
            TargetPosition.X,
            MyPosition.Y,
            TargetPosition.Z
        )

        if (FlatTarget - MyPosition).Magnitude > 0.01 then
            Root.CFrame = CFrame.lookAt(MyPosition, FlatTarget)
        end
    end
)

