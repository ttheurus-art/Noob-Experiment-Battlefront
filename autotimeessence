-- AUTO MINIGAME - FULL SCRIPT

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Auto TP System",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "AutoMinigame",
        FileName = "Config"
    },
    KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)

local Flags = {
    AutoPunch = true,
    AutoMinigame = true,
    AutoRejoin = true,
    AutoExecute = true
}

local SequenceStarted = false
local RejoinStarted = false
local ItrappedSeen = false
local LastEssenceValue = nil
local PunchConnection = nil

local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetEssences()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essences = Leaderstats and Leaderstats:FindFirstChild("Time Essences")

    if Essences then
        return Essences.Value
    end

    return nil
end

local function TeleportTo(Position)
    local Root = GetRoot()

    if not Root then
        return false
    end

    local Success = pcall(function()
        Root.CFrame = CFrame.new(Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)

    return Success
end

local function QueueAutoExecute()
    local QueueFunction =
        queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)

    if not QueueFunction then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
            ))()
        ]])
    end)
end

-- AUTO PUNCH
MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        Flags.AutoPunch = Value
    end
})

task.spawn(function()
    while task.wait(0.1) do
        if Flags.AutoPunch then
            local Character = GetCharacter()
            local Punch = Character and Character:FindFirstChild("Punch")
            local Remote = Punch and Punch:FindFirstChild("RemoteEvent")

            if Remote then
                pcall(function()
                    Remote:FireServer()
                end)
            end
        end
    end
end)

-- AUTO MINIGAME
MainTab:CreateToggle({
