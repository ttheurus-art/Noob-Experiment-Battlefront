-- AUTO MINIGAME - FULL SCRIPT

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- SINGLE INSTANCE GUARD
local Env
pcall(function()
    if getgenv then
        Env = getgenv()
    end
end)

if Env then
    if Env.AutoMinigameCleanup then
        pcall(Env.AutoMinigameCleanup)
    end
    Env.AutoMinigameRunning = false
end

local Running = true
local RenderName = "AutoMinigameFace_" .. Player.UserId

local function Cleanup()
    Running = false
    pcall(function()
        RunService:UnbindFromRenderStep(RenderName)
    end)
end

if Env then
    Env.AutoMinigameRunning = true
    Env.AutoMinigameCleanup = Cleanup
end

local function IsCurrentInstance()
    return Running and (
        not Env or Env.AutoMinigameRunning == true
    )
end

-- REMOVE OLD GUI
for _, Container in ipairs({PlayerGui, CoreGui}) do
    for _, Gui in ipairs(Container:GetChildren()) do
        if Gui.Name == "Rayfield" or Gui.Name == "Auto Minigame" then
            pcall(function()
                Gui:Destroy()
            end)
        end
    end
end

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Auto TP System",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "AutoMinigame",
        FileName = "Config"
    },
    KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)

local Flags = {
    AutoPunch = true,
    AutoMinigame = true,
    AutoRejoin = true,
    AutoExecute = true,
    FaceItrapped = true
}

local SequenceStarted = false
local RejoinStarted = false
local InitialScanFinished = false
local InitialRejoinTriggered = false
local ItrappedSeen = false
local LastEssenceValue = nil

local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function GetEssences()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essences = Leaderstats
        and Leaderstats:FindFirstChild("Time Essences")

    return Essences and Essences.Value or nil
end

local function TeleportTo(Position)
    local Root = GetRoot()
    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- QUEUE SCRIPT ON TELEPORT
-- This URL runs the existing autotimeessence script.
local function QueueAutoExecute()
    local QueueFunction

    pcall(function()
        QueueFunction = queue_on_teleport
    end)

    if not QueueFunction then
        pcall(function()
            QueueFunction = syn.queue_on_teleport
        end)
    end

    if not QueueFunction then
        pcall(function()
            QueueFunction = fluxus.queue_on_teleport
        end)
    end

    if not QueueFunction then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
            ))()
        ]])
    end)
end

-- ONE REJOIN HANDLER
local function RequestRejoin(ShouldAutoExecute)
    if RejoinStarted or not IsCurrentInstance() then
        return
    end

    RejoinStarted = true

    -- Stop all active loops before teleport.
    Flags.AutoPunch = false
    Flags.AutoMinigame = false
    Flags.FaceItrapped = false

    if ShouldAutoExecute and Flags.AutoExecute then
        QueueAutoExecute()
    end

    pcall(function()
        TeleportService:Teleport(game.PlaceId, Player)
    end)
end

-- HEALTH AT TOP
local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

-- TOGGLES
MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        Flags.AutoPunch = Value
    end
})

MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",
    Callback = function(Value)
        Flags.AutoMinigame = Value
        if not Value then
            SequenceStarted = false
        end
    end
})

MainTab:CreateToggle({
    Name = "Auto Rejoin",
    CurrentValue = true,
    Flag = "AutoRejoin",
    Callback = function(Value)
        Flags.AutoRejoin = Value
    end
})

MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = true,
    Flag = "AutoExecute",
    Callback = function(Value)
        Flags.AutoExecute = Value
    end
})

MainTab:CreateToggle({
    Name = "Always Face Itrapped",
    CurrentValue = true,
    Flag = "FaceItrapped",
    Callback = function(Value)
        Flags.FaceItrapped = Value

        local Humanoid = GetHumanoid()
        if Humanoid and not Value then
            Humanoid.AutoRotate = true
        end
    end
})

-- INITIAL SCAN: MAXIMUM 5 SECONDS
task.spawn(function()
    local StartTime = os.clock()

    while os.clock() - StartTime < 5 do
        if not IsCurrentInstance() then
            return
        end

        if workspace:FindFirstChild("Frozen Tundra") then
            InitialRejoinTriggered = true
            InitialScanFinished = true

            Flags.AutoPunch = false
            Flags.AutoMinigame = false
            Flags.AutoRejoin = false
            Flags.FaceItrapped = false

            RequestRejoin(true)
            return
        end

        task.wait(0.1)
    end

    InitialScanFinished = true
end)

-- AUTO PUNCH LOOP
task.spawn(function()
    while task.wait(0.1) do
        if not IsCurrentInstance()
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        if Flags.AutoPunch then
            local Character = GetCharacter()
            local Punch = Character and Character:FindFirstChild("Punch")
            local Remote = Punch and Punch:FindFirstChild("RemoteEvent")

            if Remote then
                pcall(function()
                    Remote:FireServer()
                end)
            end
        end
    end
end)

-- HEALTH / DEFEAT MONITOR
-- Health = 0 DOES NOT trigger rejoin.
-- Rejoin happens only after Itrapped disappears from workspace.
task.spawn(function()
    while task.wait(0.2) do
        if not IsCurrentInstance()
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        local Target = workspace:FindFirstChild("Itrapped")
        local Humanoid = Target and Target:FindFirstChildOfClass("Humanoid")

        if Target then
            ItrappedSeen = true

            if Humanoid then
                LastEssenceValue = GetEssences()

                pcall(function()
                    HealthParagraph:Set({
                        Title = "Itrapped Health",
                        Content = string.format(
                            "Health: %d / %d",
                            math.floor(Humanoid.Health),
                            math.floor(Humanoid.MaxHealth)
                        )
                    })
                end)
            end

        elseif ItrappedSeen then
            ItrappedSeen = false

            pcall(function()
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Itrapped disappeared. Checking reward..."
                })
            end)

            task.wait(1)

            if not IsCurrentInstance() then
                return
            end

            local CurrentEssences = GetEssences()

            if CurrentEssences ~= nil
                and LastEssenceValue ~= nil
                and CurrentEssences > LastEssenceValue then

                Rayfield:Notify({
                    Title = "Time Essence",
                    Content = "You Got Time Essence!",
                    Duration = 4
                })
            else
                Rayfield:Notify({
                    Title = "Time Essence",
                    Content = "You Don't Get Time Essence, GL Next Time",
                    Duration = 4
                })
            end

            pcall(function()
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Waiting for Itrapped..."
                })
            end)

            if Flags.AutoRejoin then
                -- Do not queue another auto-execute here.
                RequestRejoin(false)
                return
            end
        end
    end
end)

-- TP SEQUENCE: START AFTER INITIAL SCAN
task.spawn(function()
    while not InitialScanFinished do
        if not IsCurrentInstance() then
            return
        end
        task.wait(0.05)
    end

    if InitialRejoinTriggered then
        return
    end

    while task.wait(0.2) do
        if not IsCurrentInstance()
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        if Flags.AutoMinigame and not SequenceStarted then
            SequenceStarted = true

            task.spawn(function()
                task.wait(16)

                if not IsCurrentInstance()
                    or not Flags.AutoMinigame
                    or RejoinStarted then
                    SequenceStarted = false
                    return
                end

                -- TP1 UNTIL BATTLEFIELD IS GONE
                -- AND FROZEN TUNDRA EXISTS
                while Flags.AutoMinigame and not RejoinStarted do
                    local Battlefield =
                        workspace:FindFirstChild("Battlefield")

                    local FrozenTundra =
                        workspace:FindFirstChild("Frozen Tundra")

                    if not Battlefield and FrozenTundra then
                        break
                    end

                    TeleportTo(Vector3.new(99, -18, 193))
                    task.wait(0.2)
                end

                if not Flags.AutoMinigame or RejoinStarted then
                    SequenceStarted = false
                    return
                end

                -- TP2 UNTIL ITRAPPED APPEARS
                while Flags.AutoMinigame and not RejoinStarted do
                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot =
                        Target and Target:FindFirstChild("HumanoidRootPart")

                    if TargetRoot then
                        break
                    end

                    TeleportTo(Vector3.new(85, -16, 59))
                    task.wait(0.2)
                end

                -- FOLLOW ITRAPPED FROM BEHIND
                while Flags.AutoMinigame and not RejoinStarted do
                    local Target = workspace:FindFirstChild("Itrapped")
                    local TargetRoot =
                        Target and Target:FindFirstChild("HumanoidRootPart")
                    local Root = GetRoot()

                    if not TargetRoot or not Root then
                        break
                    end

                    pcall(function()
                        Root.CFrame =
                            TargetRoot.CFrame * CFrame.new(0, 0, 3)

                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end)

                    RunService.Heartbeat:Wait()
                end

                SequenceStarted = false
            end)
        end
    end
end)

-- ALWAYS FACE ITRAPPED
RunService:BindToRenderStep(
    RenderName,
    Enum.RenderPriority.Character.Value + 1,
    function()
        if not IsCurrentInstance()
            or not Flags.FaceItrapped
            or InitialRejoinTriggered
            or RejoinStarted then
            return
        end

        local Character = workspace:FindFirstChild(Player.Name)
            or GetCharacter()

        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")

        local Target = workspace:FindFirstChild("Itrapped")
        local TargetRoot =
            Target and Target:FindFirstChild("HumanoidRootPart")

        if not Root or not Humanoid or not TargetRoot then
            if Humanoid then
                Humanoid.AutoRotate = true
            end
            return
        end

        Humanoid.AutoRotate = false

        local MyPosition = Root.Position
        local TargetPosition = TargetRoot.Position

        local FlatTarget = Vector3.new(
            TargetPosition.X,
            MyPosition.Y,
            TargetPosition.Z
        )

        if (FlatTarget - MyPosition).Magnitude > 0.01 then
            Root.CFrame = CFrame.lookAt(MyPosition, FlatTarget)
        end
    end
)

Rayfield:Notify({
    Title = "Auto Minigame",
    Content = "Script loaded!",
    Duration = 4
})
