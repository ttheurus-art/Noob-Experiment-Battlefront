-- CHARACTER HELPERS
local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function GetEssences()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    local Essences = Leaderstats
        and Leaderstats:FindFirstChild("Time Essences")

    return Essences and Essences.Value or nil
end

local function TeleportTo(Position)
    local Root = GetRoot()
    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- QUEUE AUTO EXECUTE
local function QueueAutoExecute()
    local QueueFunction

    pcall(function()
        if type(queue_on_teleport) == "function" then
            QueueFunction = queue_on_teleport
        end
    end)

    if not QueueFunction then
        pcall(function()
            if type(syn) == "table"
                and type(syn.queue_on_teleport) == "function" then
                QueueFunction = syn.queue_on_teleport
            end
        end)
    end

    if not QueueFunction then
        pcall(function()
            if type(fluxus) == "table"
                and type(fluxus.queue_on_teleport) == "function" then
                QueueFunction = fluxus.queue_on_teleport
            end
        end)
    end

    if not QueueFunction then
        warn("Auto Execute: queue API unavailable.")
        return false
    end

    local Queued, ErrorMessage = pcall(function()
        QueueFunction([[
            task.wait(2)

            local Success, ErrorMessage = pcall(function()
                loadstring(game:HttpGet(
                    "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessence"
                ))()
            end)

            if not Success then
                warn("Auto Execute failed:", ErrorMessage)
            end
        ]])
    end)

    if not Queued then
        warn("Auto Execute queue failed:", ErrorMessage)
        return false
    end

    return true
end

-- REJOIN STATE
local AttemptTeleport

-- TELEPORT ATTEMPT
AttemptTeleport = function()
    if not IsCurrentInstance() or not RejoinStarted then
        return
    end

    if TeleportAttempts >= MaxTeleportAttempts then
        warn("Auto Rejoin: maximum attempts reached.")

        RejoinStarted = false
        TeleportRetryScheduled = false
        return
    end

    TeleportAttempts += 1
    TeleportRetryScheduled = false

    -- Rejoin the same Roblox experience.
    -- Roblox chooses an available server.
    local Success, ErrorMessage = pcall(function()
        TeleportService:Teleport(game.PlaceId, Player)
    end)

    if not Success then
        warn("Teleport attempt failed:", ErrorMessage)

        if not TeleportRetryScheduled then
            TeleportRetryScheduled = true

            task.delay(2, function()
                if IsCurrentInstance() and RejoinStarted then
                    AttemptTeleport()
                end
            end)
        end
    end
end

-- RETRY WHEN ROBLOX REPORTS TELEPORT FAILURE
TeleportService.TeleportInitFailed:Connect(function(
    FailedPlayer,
    TeleportResult,
    ErrorMessage
)
    if FailedPlayer ~= Player
        or not RejoinStarted
        or not IsCurrentInstance() then
        return
    end

    warn(
        "Teleport failed:",
        tostring(TeleportResult),
        tostring(ErrorMessage)
    )

    if not TeleportRetryScheduled then
        TeleportRetryScheduled = true

        task.delay(2, function()
            if IsCurrentInstance() and RejoinStarted then
                AttemptTeleport()
            end
        end)
    end
end)

-- ONE COMMON REJOIN FUNCTION
local function RequestRejoin()
    if RejoinStarted or not IsCurrentInstance() then
        return
    end

    RejoinStarted = true
    TeleportAttempts = 0
    TeleportRetryScheduled = false

    Flags.AutoPunch = false
    Flags.AutoMinigame = false
    Flags.FaceItrapped = false

    local Humanoid = GetHumanoid()
    if Humanoid then
        Humanoid.AutoRotate = true
    end

    -- Queue Auto Execute before teleporting.
    if Flags.AutoExecute then
        QueueAutoExecute()
        task.wait(0.5)
    end

    if not IsCurrentInstance() then
        return
    end

    AttemptTeleport()
end

