
-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Player = Players.LocalPlayer

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "By Theurus",
    Theme = "Ocean",
    ConfigurationSaving = {
        Enabled = false
    }
})

local MainTab = Window:CreateTab("Main", 4483362458)

-- VARIABLES
local AutoPunch = true
local AutoMinigame = true
local AutoRejoin = true
local AutoExecute = true
local AlwaysFaceItrapped = true
local AutoKillItrapped = true
local AutoDetectFrozenTundra = true

local Rejoining = false
local MinigameRunId = 0

local ScriptURL =
    "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessenc"

-- HEALTH DISPLAY
local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

task.spawn(function()
    while task.wait(0.2) do
        local Target = workspace:FindFirstChild("Itrapped")
        local Humanoid = Target and Target:FindFirstChildOfClass("Humanoid")

        if Humanoid then
            pcall(function()
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Health: "
                        .. math.floor(Humanoid.Health)
                        .. " / "
                        .. math.floor(Humanoid.MaxHealth)
                })
            end)
        else
            pcall(function()
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Waiting for Itrapped..."
                })
            end)
        end
    end
end)

-- AUTO PUNCH
MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        AutoPunch = Value
    end
})

task.spawn(function()
    while task.wait(0.1) do
        if AutoPunch then
            local Character = Player.Character
            local Punch = Character and Character:FindFirstChild("Punch")
            local Remote = Punch and Punch:FindFirstChild("RemoteEvent")

            if Remote and Remote:IsA("RemoteEvent") then
                pcall(function()
                    Remote:FireServer()
                end)
            end
        end
    end
end)

-- AUTO MINIGAME
MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",
    Callback = function(Value)
        AutoMinigame = Value
        MinigameRunId += 1
    end
})

task.spawn(function()
    while task.wait(0.1) do
        if AutoMinigame then
            local Character = Player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

            if Character and Humanoid and Humanoid.Health > 0 then
                if not workspace:FindFirstChild("Frozen Tundra") then
                    Character:MoveTo(Vector3.new(99, -23, 193))
                elseif not workspace:FindFirstChild("Itrapped") then
                    Character:MoveTo(Vector3.new(85, -16, 59))
                end
            end
        end
    end
end)

-- AUTO KILL ITRAPPED: CFrame 2 STUDS BEHIND
MainTab:CreateToggle({
    Name = "Auto Kill Itrapped",
    CurrentValue = true,
    Flag = "AutoKillItrapped",
    Callback = function(Value)
        AutoKillItrapped = Value
    end
})

RunService.Heartbeat:Connect(function()
    if not AutoKillItrapped then
        return
    end

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Target = workspace:FindFirstChild("Itrapped")

    local TargetRoot = Target and (
        Target:FindFirstChild("HumanoidRootPart")
        or Target.PrimaryPart
    )

    if Root and TargetRoot then
        pcall(function()
            Root.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, 2)
        end)
    end
end)

-- ALWAYS FACE ITRAPPED
MainTab:CreateToggle({
    Name = "Always Face Itrapped",
    CurrentValue = true,
    Flag = "AlwaysFaceItrapped",
    Callback = function(Value)
        AlwaysFaceItrapped = Value
    end
})

RunService.Heartbeat:Connect(function()
    if not AlwaysFaceItrapped or AutoKillItrapped then
        return
    end

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Target = workspace:FindFirstChild("Itrapped")

    local TargetRoot = Target and (
        Target:FindFirstChild("HumanoidRootPart")
        or Target.PrimaryPart
    )

    if Root and TargetRoot then
        pcall(function()
            local Position = Root.Position
            local TargetPosition = TargetRoot.Position

            Root.CFrame = CFrame.lookAt(
                Position,
                Vector3.new(
                    TargetPosition.X,
                    Position.Y,
                    TargetPosition.Z
                )
            )
        end)
    end
end)

-- AUTO DETECT FROZEN TUNDRA
MainTab:CreateToggle({
    Name = "Auto Detect Frozen Tundra",
    CurrentValue = true,
    Flag = "AutoDetectFrozenTundra",
    Callback = function(Value)
        AutoDetectFrozenTundra = Value
    end
})

local FrozenParagraph = MainTab:CreateParagraph({
    Title = "Frozen Tundra Detection",
    Content = "Scanning..."
})

task.spawn(function()
    while task.wait(5) do
        if AutoDetectFrozenTundra then
            local Found = workspace:FindFirstChild("Frozen Tundra") ~= nil

            pcall(function()
                FrozenParagraph:Set({
                    Title = "Frozen Tundra Detection",
                    Content = Found and "Frozen Tundra detected."
                        or "Frozen Tundra not found."
                })
            end)
        end
    end
end)

-- AUTO EXECUTE
MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = true,
    Flag = "AutoExecute",
    Callback = function(Value)
        AutoExecute = Value
    end
})

local function QueueAutoExecute()
    if not AutoExecute then
        return
    end

    local QueueFunction =
        queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)

    if type(QueueFunction) == "function" then
        pcall(function()
            QueueFunction(
                'loadstring(game:HttpGet("' .. ScriptURL .. '"))()'
            )
        end)
    end
end

-- AUTO REJOIN: WHEN ITRAPPED DISAPPEARS
MainTab:CreateToggle({
    Name = "Auto Rejoin",
    CurrentValue = true,
    Flag = "AutoRejoin",
    Callback = function(Value)
        AutoRejoin = Value
    end
})

task.spawn(function()
    local TargetWasDetected =
        workspace:FindFirstChild("Itrapped") ~= nil

    while task.wait(0.2) do
        local TargetExists =
            workspace:FindFirstChild("Itrapped") ~= nil

        if TargetExists then
            TargetWasDetected = true
        elseif TargetWasDetected then
            TargetWasDetected = false

            if AutoRejoin and not Rejoining then
                Rejoining = true

                task.spawn(function()
                    QueueAutoExecute()

                    local Success = pcall(function()
                        if #Players:GetPlayers() <= 1 then
                            -- Infinite Yield-style single-player rejoin
                            Player:Kick("\nRejoining...")
                            task.wait()
                            TeleportService:Teleport(
                                game.PlaceId,
                                Player
                            )
                        else
                            -- Rejoin the current server instance
                            TeleportService:TeleportToPlaceInstance(
                                game.PlaceId,
                                game.JobId,
                                Player
                            )
                        end
                    end)

                    if not Success then
                        Rejoining = false
                    end
                end)
            end
        end
    end
end)
