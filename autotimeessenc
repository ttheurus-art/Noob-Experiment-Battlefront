-- SERVICES
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local TP_INTERVAL = 0.1
local INITIAL_DELAY = 5
local REJOIN_DELAY = 2

local TP1_POSITION = Vector3.new(99, -18, 193)
local TP2_POSITION = Vector3.new(85, -16, 59)

--==================================================
-- STATES
--==================================================

local AutoPunchRunning = false
local AutoMinigameRunning = false
local AutoTP3Running = false
local AutoRejoinEnabled = true
local AutoExecuteEnabled = false

local Rejoining = false
local TP3Connection = nil

--==================================================
-- RAYFIELD
--==================================================

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Auto Minigame",
    LoadingTitle = "Auto Minigame",
    LoadingSubtitle = "Automation Panel",
    Theme = "Ocean",

    ConfigurationSaving = {
        Enabled = false
    }
})

local MainTab = Window:CreateTab("Main", 4483362458)

local function Notify(Title, Content)
    Rayfield:Notify({
        Title = Title,
        Content = Content,
        Duration = 5
    })
end

--==================================================
-- HEALTH MONITOR (ALWAYS AT THE TOP)
--==================================================

local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

task.spawn(function()
    while task.wait(0.2) do
        local Target = workspace:FindFirstChild("Itrapped")

        if Target then
            local Humanoid = Target:FindFirstChildOfClass("Humanoid")

            if Humanoid then
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Health: "
                        .. math.floor(Humanoid.Health)
                        .. " / "
                        .. math.floor(Humanoid.MaxHealth)
                })
            else
                HealthParagraph:Set({
                    Title = "Itrapped Health",
                    Content = "Itrapped detected."
                })
            end
        else
            HealthParagraph:Set({
                Title = "Itrapped Health",
                Content = "Waiting for Itrapped..."
            })
        end
    end
end)

--==================================================
-- TELEPORT HELPER
--==================================================

local function TeleportTo(Position)
    local Character = Player.Character
    local Root = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return false
    end

    return pcall(function()
        Root.CFrame = CFrame.new(Position)
    end)
end

--==================================================
-- AUTO EXECUTE QUEUE
--==================================================

local function QueueAutoExecute()
    if not AutoExecuteEnabled then
        return
    end

    if type(queue_on_teleport) ~= "function" then
        warn("queue_on_teleport unavailable.")
        return
    end

    local Success, ErrorMessage = pcall(function()
        queue_on_teleport([[
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessenc"))()
        ]])
    end)

    if not Success then
        warn("Auto Execute failed: " .. tostring(ErrorMessage))
    end
end

--==================================================
-- REJOIN: REJOINCLIENT + KICK
--==================================================

local function AutoRejoin()
    if not AutoRejoinEnabled or Rejoining then
        return
    end

    Rejoining = true

    task.spawn(function()
        if AutoExecuteEnabled then
            QueueAutoExecute()
        end

        task.wait(1)

        -- Executor-specific rejoin function
        local RejoinFunction = Rejoinclient

        if type(RejoinFunction) == "function" then
            pcall(function()
                RejoinFunction()
            end)
        end

        -- Kick player
        Player:Kick("Rejoining...")
    end)
end

--==================================================
-- TOGGLE: AUTO PUNCH
--==================================================

MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",

    Callback = function(Value)
        AutoPunchRunning = Value

        if not Value then
            return
        end

        task.spawn(function()
            while AutoPunchRunning do
                local Character = Player.Character
                local Punch = Character
                    and Character:FindFirstChild("Punch")

                local Remote = Punch
                    and Punch:FindFirstChild("RemoteEvent")

                if Remote and Remote:IsA("RemoteEvent") then
                    pcall(function()
                        Remote:FireServer()
                    end)
                end

                task.wait(0.1)
            end
        end)
    end
})

--==================================================
-- TOGGLE: AUTO MINIGAME (TP1 + TP2)
--==================================================

MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",

    Callback = function(Value)
        AutoMinigameRunning = Value

        if not Value then
            return
        end

        task.spawn(function()
            task.wait(INITIAL_DELAY)

            if not AutoMinigameRunning then
                return
            end

            -- TP1: wait for Frozen Tundra
            while AutoMinigameRunning do
                if workspace:FindFirstChild("Frozen Tundra") then
                    break
                end

                TeleportTo(TP1_POSITION)
                task.wait(TP_INTERVAL)
            end

            if not AutoMinigameRunning then
                return
            end

            -- TP2: wait for Itrapped
            while AutoMinigameRunning do
                if workspace:FindFirstChild("Itrapped") then
                    break
                end

                TeleportTo(TP2_POSITION)
                task.wait(TP_INTERVAL)
            end
        end)
    end
})

--==================================================
-- TOGGLE: AUTO TP3
--==================================================

MainTab:CreateToggle({
    Name = "Auto TP3",
    CurrentValue = true,
    Flag = "AutoTP3",

    Callback = function(Value)
        AutoTP3Running = Value

        if TP3Connection then
            TP3Connection:Disconnect()
            TP3Connection = nil
        end

        if not Value then
            return
        end

        TP3Connection = RunService.Heartbeat:Connect(function()
            if not AutoTP3Running then
                return
            end

            local Target = workspace:FindFirstChild("Itrapped")

            local TargetRoot = Target and (
                Target:FindFirstChild("HumanoidRootPart")
                or Target.PrimaryPart
            )

            local Character = Player.Character
            local PlayerRoot = Character
                and Character:FindFirstChild("HumanoidRootPart")

            if not TargetRoot or not PlayerRoot then
                return
            end

            pcall(function()
                PlayerRoot.CFrame =
                    TargetRoot.CFrame * CFrame.new(0, 0, 3)
            end)
        end)
    end
})

--==================================================
-- TOGGLE: AUTO REJOIN
--==================================================

MainTab:CreateToggle({
    Name = "Auto Rejoin",
    CurrentValue = true,
    Flag = "AutoRejoin",

    Callback = function(Value)
        AutoRejoinEnabled = Value
    end
})

--==================================================
-- TOGGLE: AUTO EXECUTE
--==================================================

MainTab:CreateToggle({
    Name = "Auto Execute",
    CurrentValue = false,
    Flag = "AutoExecuteTeleport",

    Callback = function(Value)
        AutoExecuteEnabled = Value

        if Value then
            QueueAutoExecute()
        end
    end
})

--==================================================
-- AUTO DETECT REJOIN
-- Uses the SAME AutoRejoin() function above
--==================================================

task.spawn(function()
    local TargetWasDetected = false

    while task.wait(0.2) do
        local Target = workspace:FindFirstChild("Itrapped")

        if Target then
            TargetWasDetected = true

        elseif TargetWasDetected then
            TargetWasDetected = false

            if AutoRejoinEnabled then
                Notify(
                    "Auto Rejoin",
                    "Itrapped disappeared. Rejoining..."
                )

                task.delay(REJOIN_DELAY, function()
                    if AutoRejoinEnabled then
                        AutoRejoin()
                    end
                end)
            end
        end
    end
end)

