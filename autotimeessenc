--==================================================
-- 3. AUTO KILL ITRAPPED
--==================================================
local AutoKillItrapped = true

MainTab:CreateToggle({
    Name = "Auto Kill Itrapped",
    CurrentValue = true,
    Flag = "AutoKillItrapped",
    Callback = function(Value)
        AutoKillItrapped = Value
    end
})

RunService.Heartbeat:Connect(function()
    if not AutoKillItrapped then
        return
    end

    local Target = workspace:FindFirstChild("Itrapped")
    if not Target then
        return
    end

    local Root = Target:FindFirstChild("HumanoidRootPart")
        or Target.PrimaryPart

    local Character = Player.Character
    local PlayerRoot = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root or not PlayerRoot then
        return
    end

    -- 2 STUD DI BELAKANG
    -- OFFSET KANAN = 0
    -- OFFSET ATAS = 0
    local BehindPosition =
        Root.Position - Root.CFrame.LookVector * 2

    pcall(function()
        Character:MoveTo(BehindPosition)
    end)
end)

