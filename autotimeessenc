        and Character:FindFirstChild("HumanoidRootPart")

    if not Root or not PlayerRoot then
        return
    end

    -- 2 STUD DI BELAKANG
    -- OFFSET KANAN = 0
    -- OFFSET ATAS = 0
    pcall(function()
        PlayerRoot.CFrame =
            Root.CFrame * CFrame.new(0, 0, 2)
    end)
end)

