--==================================================
-- 3. AUTO KILL ITRAPPED
--==================================================
local AutoKillItrapped = true

MainTab:CreateToggle({
    Name = "Auto Kill Itrapped",
    CurrentValue = true,
    Flag = "AutoKillItrapped",
    Callback = function(Value)
        AutoKillItrapped = Value
    end
})

task.spawn(function()
    while true do
        if AutoKillItrapped then
            local Target = workspace:FindFirstChild("Itrapped")

            if Target then
                local Root = Target:FindFirstChild("HumanoidRootPart")
                    or Target.PrimaryPart

                if Root then
                    local Character = Player.Character

                    if Character then
                        pcall(function()
                            Character:MoveTo(
                                Root.Position - Root.CFrame.LookVector * 2
                            )
                        end)
                    end
                end
            end
        end

        task.wait(0)
    end
end)

--==================================================
-- 4. AUTO REJOIN
--==================================================
local AutoRejoin = true
local Rejoining = false

MainTab:CreateToggle({
    Name = "Auto Rejoin",
    CurrentValue = true,
    Flag = "AutoRejoin",
    Callback = function(Value)
        AutoRejoin = Value
    end
})

task.spawn(function()
    local TargetWasDetected =
        workspace:FindFirstChild("Itrapped") ~= nil

    while true do
        local TargetExists =
            workspace:FindFirstChild("Itrapped") ~= nil

        if TargetExists then
            TargetWasDetected = true
        elseif TargetWasDetected then
            TargetWasDetected = false

            if AutoRejoin and not Rejoining then
                task.spawn(function()
                    if not AutoRejoin or Rejoining then
                        return
                    end

                    Rejoining = true

                    if AutoExecute
                        and type(queue_on_teleport) == "function" then

                        pcall(function()
                            queue_on_teleport([[
                                loadstring(game:HttpGet(
                                    "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessenc"
                                ))()
                            ]])
                        end)
                    end

                    if type(Rejoinclient) == "function" then
                        pcall(function()
                            Rejoinclient()
                        end)
                    end

                    Player:Kick("Rejoining...")
                end)
            end
        end

        task.wait(0.2)
    end
end)

