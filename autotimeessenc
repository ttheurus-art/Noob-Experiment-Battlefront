local function RunAutoMinigame(RunId)
    task.wait(5)

    -- TP1: Wait for Frozen Tundra
    while AutoMinigame
        and RunId == MinigameRunId
        and not workspace:FindFirstChild("Frozen Tundra") do

        local Character = Player.Character

        if Character then
            pcall(function()
                Character:MoveTo(
                    Vector3.new(99, -23, 193)
                )
            end)
        end

        task.wait(0.1)
    end

    -- TP2: Wait for Itrapped
    while AutoMinigame
        and RunId == MinigameRunId
        and not workspace:FindFirstChild("Itrapped") do

        local Character = Player.Character

        if Character then
            pcall(function()
                Character:MoveTo(
                    Vector3.new(85, -16, 59)
                )
            end)
        end

        task.wait(0.1)
    end
end

