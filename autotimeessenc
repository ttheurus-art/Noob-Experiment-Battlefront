-- TOGGLE 6: AUTO DETECT FROZEN TUNDRA
--==================================================
local function StartFrozenScan()
    FrozenScanId += 1
    local MyScanId = FrozenScanId

    task.spawn(function()
        local StartTime = os.clock()

        repeat
            if MyScanId ~= FrozenScanId then
                return
            end

            if workspace:FindFirstChild("Frozen Tundra") then
                RequestRejoin(true)
                return
            end

            task.wait(0.2)
        until os.clock() - StartTime >= 5
    end)
end

MainTab:CreateToggle({
    Name = "Auto Detect Frozen Tundra",
    CurrentValue = true,
    Flag = "AutoDetectFrozenTundra",
    Callback = function(Value)
        AutoDetectFrozenTundra = Value

        if Value then
            StartFrozenScan()
        else
            FrozenScanId += 1
        end
    end
})

if AutoDetectFrozenTundra then
    StartFrozenScan()
end

--==================================================
-- PARAGRAPH 4: SERVER SCANNER
-- Rejoin if server has 2+ players for 1 second
--==================================================
local ServerScannerParagraph = MainTab:CreateParagraph({
    Title = "Server Scanner",
    Content = "Scanning server..."
})

task.spawn(function()
    local ConditionStart = nil

    while task.wait(0.2) do
        local PlayerCount = #Players:GetPlayers()

        if PlayerCount >= 2 then
            if not ConditionStart then
                ConditionStart = os.clock()
            end

            local Elapsed = os.clock() - ConditionStart

            ServerScannerParagraph:Set({
                Title = "Server Scanner",
                Content = "Players: "
                    .. PlayerCount
                    .. " | Condition: "
                    .. FormatTime(Elapsed)
                    .. " / 00:01"
            })

            if Elapsed >= 1 then
                ServerScannerParagraph:Set({
                    Title = "Server Scanner",
                    Content = "2+ players detected. Rejoining..."
                })

                RequestRejoin(true)
                return
            end
        else
            ConditionStart = nil

            ServerScannerParagraph:Set({
                Title = "Server Scanner",
                Content = "Players: "
                    .. PlayerCount
                    .. " | Waiting for 2 players..."
            })
        end
    end
end)
