--==================================================
-- HELPERS
--==================================================
local function FormatTime(Seconds)
    Seconds = math.max(0, math.floor(Seconds))

    local Minutes = math.floor(Seconds / 60)
    local RemainingSeconds = Seconds % 60

    return string.format(
        "%02d:%02d",
        Minutes,
        RemainingSeconds
    )
end

--==================================================
-- QUEUE AUTO EXECUTE
--==================================================
local function QueueAutoExecute()
    if not AutoExecute then
        return false
    end

    local QueueFunction = queue_on_teleport

    if not QueueFunction and syn then
        QueueFunction = syn.queue_on_teleport
    end

    if not QueueFunction and fluxus then
        QueueFunction = fluxus.queue_on_teleport
    end

    if type(QueueFunction) ~= "function" then
        return false
    end

    return pcall(function()
        QueueFunction(
            'loadstring(game:HttpGet("' .. ScriptURL .. '"))()'
        )
    end)
end

--==================================================
-- SHARED REJOIN
--==================================================
local function RequestRejoin(ShouldQueue)
    if Rejoining then
        return
    end

    Rejoining = true

    task.spawn(function()
        if ShouldQueue then
            QueueAutoExecute()
        end

        task.wait(1.25)

        local Success = pcall(function()
            if #Players:GetPlayers() <= 1 then
                Player:Kick("Rejoining...")
                task.wait()

                TeleportService:Teleport(
                    game.PlaceId,
                    Player
                )
            else
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    game.JobId,
                    Player
                )
            end
        end)

        if not Success then
            Rejoining = false
        end
    end)
end

