--==================================================
-- 6. AUTO DETECT FROZEN TUNDRA
-- MEMINDAI MAKSIMAL 5 DETIK
--==================================================
local function StartFrozenScan()
    FrozenScanId += 1
    local MyScanId = FrozenScanId

    task.spawn(function()
        local StartTime = os.clock()

        repeat
            if MyScanId ~= FrozenScanId then
                return
            end

            if workspace:FindFirstChild("Frozen Tundra") then
                -- Hentikan fitur lain
                AutoPunch = false

                AutoMinigame = false
                MinigameRunId += 1

                AutoKillItrapped = false
                AutoRejoin = false

                -- Gunakan jalur rejoin yang sama
                RequestRejoin(true)
                return
            end

            task.wait(0.2)
        until os.clock() - StartTime >= 5
    end)
end

MainTab:CreateToggle({
    Name = "Auto Detect Frozen Tundra",
    CurrentValue = true,
    Flag = "AutoDetectFrozenTundra",
    Callback = function(Value)
        AutoDetectFrozenTundra = Value

        if Value then
            StartFrozenScan()
        else
            FrozenScanId += 1
        end
    end
})

-- MULAI SCAN SAAT SCRIPT DIEKSEKUSI
if AutoDetectFrozenTundra then
    StartFrozenScan()
end
