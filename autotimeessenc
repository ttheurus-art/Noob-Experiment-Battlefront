--==================================================
-- PARAGRAPH 3: ITRAPPED TIMER
-- Missing: 50 seconds -> rejoin
-- Present: 3 minutes -> rejoin
--==================================================
local ItrappedTimerParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Timer",
    Content = "Waiting for Itrapped..."
})

task.spawn(function()
    local CurrentMode = nil
    local ModeStart = os.clock()

    while task.wait(0.2) do
        local TargetExists =
            workspace:FindFirstChild("Itrapped") ~= nil

        local NewMode = TargetExists and "PRESENT" or "MISSING"

        if NewMode ~= CurrentMode then
            CurrentMode = NewMode
            ModeStart = os.clock()
        end

        local Elapsed = os.clock() - ModeStart

        if CurrentMode == "MISSING" then
            ItrappedTimerParagraph:Set({
                Title = "Itrapped Timer",
                Content = "Itrapped missing: "
                    .. FormatTime(Elapsed)
                    .. " / 00:50"
            })

            if Elapsed >= 50 then
                ItrappedTimerParagraph:Set({
                    Title = "Itrapped Timer",
                    Content = "Itrapped missing for 50 seconds. Rejoining..."
                })

                RequestRejoin(true)
                return
            end
        else
            ItrappedTimerParagraph:Set({
                Title = "Itrapped Timer",
                Content = "Itrapped present: "
                    .. FormatTime(Elapsed)
                    .. " / 03:00"
            })

            if Elapsed >= 180 then
                ItrappedTimerParagraph:Set({
                    Title = "Itrapped Timer",
                    Content = "Itrapped present for 3 minutes. Rejoining..."
                })

                RequestRejoin(true)
                return
            end
        end
    end
end)

