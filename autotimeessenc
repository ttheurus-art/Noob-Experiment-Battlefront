--==================================================
-- AUTO EXECUTE QUEUE
--==================================================
local function QueueAutoExecute()
    if not AutoExecute then
        return false
    end

    local QueueFunction =
        queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)

    if type(QueueFunction) ~= "function" then
        return false
    end

    return pcall(function()
        QueueFunction([[
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/ttheurus-art/Noob-Experiment-Battlefront/refs/heads/main/autotimeessenc"
            ))()
        ]])
    end)
end

--==================================================
-- SHARED REJOIN
-- Auto Rejoin dan Frozen Tundra memakai fungsi ini
--==================================================
local function RequestRejoin(ShouldQueue)
    if Rejoining then
        return
    end

    Rejoining = true

    task.spawn(function()
        if ShouldQueue then
            QueueAutoExecute()
        end

        task.wait(1.25)

        local Success = pcall(function()
            TeleportService:Teleport(game.PlaceId, Player)
        end)

        if not Success then
            Rejoining = false
        end
    end)
end

