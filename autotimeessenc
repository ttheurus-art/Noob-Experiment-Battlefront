-- 2. AUTO MINIGAME
--==================================================
local AutoMinigame = true
local MinigameRunId = 0

MainTab:CreateToggle({
    Name = "Auto Minigame",
    CurrentValue = true,
    Flag = "AutoMinigame",
    Callback = function(Value)
        AutoMinigame = Value
        MinigameRunId += 1

        if Value then
            local RunId = MinigameRunId

            task.spawn(function()
                task.wait(5)

                -- TP1: Y = -23
                while AutoMinigame
                    and RunId == MinigameRunId
                    and not workspace:FindFirstChild("Frozen Tundra") do

                    local Character = Player.Character

                    if Character then
                        pcall(function()
                            Character:MoveTo(
                                Vector3.new(99, -23, 193)
                            )
                        end)
                    end

                    task.wait(0.1)
                end

                -- TP2
                while AutoMinigame
                    and RunId == MinigameRunId
                    and not workspace:FindFirstChild("Itrapped") do

                    local Character = Player.Character

                    if Character then
                        pcall(function()
                            Character:MoveTo(
                                Vector3.new(85, -16, 59)
                            )
                        end)
                    end

                    task.wait(0.1)
                end
            end)
        end
    end
})

