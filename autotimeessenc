--==================================================
-- QUEUE AUTO EXECUTE
-- SATU TEMPAT SAJA YANG MEMBUAT QUEUE
--==================================================
local function QueueAutoExecute()
    if not AutoExecute then
        return false
    end

    local QueueFunction = queue_on_teleport

    if not QueueFunction and syn then
        QueueFunction = syn.queue_on_teleport
    end

    if not QueueFunction and fluxus then
        QueueFunction = fluxus.queue_on_teleport
    end

    if type(QueueFunction) ~= "function" then
        return false
    end

    local Success = pcall(function()
        QueueFunction(
            'loadstring(game:HttpGet("' .. ScriptURL .. '"))()'
        )
    end)

    return Success
end

--==================================================
-- IY-STYLE REJOIN
-- DIPAKAI OLEH AUTO REJOIN DAN AUTO DETECT
--==================================================
local function RequestRejoin(ShouldQueue)
    if Rejoining then
        return
    end

    Rejoining = true

    task.spawn(function()
        -- QUEUE HANYA SEKALI SEBELUM REJOIN
        if ShouldQueue then
            QueueAutoExecute()
        end

        task.wait(1.25)

        local Success = pcall(function()
            if #Players:GetPlayers() <= 1 then
                -- POLA REJOIN SAAT SENDIRIAN
                Player:Kick("Rejoining...")
                task.wait()

                TeleportService:Teleport(
                    game.PlaceId,
                    Player
                )
            else
                -- POLA REJOIN SAAT ADA PEMAIN LAIN
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    game.JobId,
                    Player
                )
            end
        end)

        if not Success then
            Rejoining = false
        end
    end)
end

