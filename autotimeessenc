--==================================================
-- 6. AUTO DETECT FROZEN TUNDRA
-- Scan maksimal 5 detik
--==================================================
local function DisableOtherFeatures()
    AutoPunch = false

    AutoMinigame = false
    MinigameRunId += 1

    AutoKillItrapped = false
    AutoRejoin = false
    AutoExecute = false
end

local function StartFrozenScan()
    FrozenScanId += 1
    local MyScanId = FrozenScanId

    FrozenDetectionTriggered = false

    task.spawn(function()
        local StartTime = os.clock()

        repeat
            if MyScanId ~= FrozenScanId then
                return
            end

            if workspace:FindFirstChild("Frozen Tundra") then
                if FrozenDetectionTriggered then
                    return
                end

                FrozenDetectionTriggered = true

                -- Queue sebelum AutoExecute dimatikan
                local ShouldQueue = AutoExecute

                if ShouldQueue then
                    QueueAutoExecute()
                end

                -- Matikan fungsi toggle lain
                DisableOtherFeatures()

                -- Jangan queue dua kali
                RequestRejoin(false)
                return
            end

            task.wait(0.2)
        until os.clock() - StartTime >= 5
    end)
end

MainTab:CreateToggle({
    Name = "Auto Detect Frozen Tundra",
    CurrentValue = true,
    Flag = "AutoDetectFrozenTundra",
    Callback = function(Value)
        if Value then
            StartFrozenScan()
        else
            FrozenScanId += 1
        end
    end
})

-- Mulai scan saat script pertama kali dijalankan
StartFrozenScan()
