-- HEALTH MONITOR
--==================================================
local HealthParagraph = MainTab:CreateParagraph({
    Title = "Itrapped Health",
    Content = "Waiting for Itrapped..."
})

task.spawn(function()
    while task.wait(0.2) do
        local Target = workspace:FindFirstChild("Itrapped")
        local Humanoid = Target
            and Target:FindFirstChildOfClass("Humanoid")

        if Humanoid then
            HealthParagraph:Set({
                Title = "Itrapped Health",
                Content = "Health: "
                    .. math.floor(Humanoid.Health)
                    .. " / "
                    .. math.floor(Humanoid.MaxHealth)
            })
        else
            HealthParagraph:Set({
                Title = "Itrapped Health",
                Content = "Waiting for Itrapped..."
            })
        end
    end
end)

--==================================================
-- 1. AUTO PUNCH
--==================================================
local AutoPunch = true

MainTab:CreateToggle({
    Name = "Auto Punch",
    CurrentValue = true,
    Flag = "AutoPunch",
    Callback = function(Value)
        AutoPunch = Value
    end
})

task.spawn(function()
    while true do
        if AutoPunch then
            local Character = Player.Character
            local Punch = Character
                and Character:FindFirstChild("Punch")
            local Remote = Punch
                and Punch:FindFirstChild("RemoteEvent")

            if Remote then
                pcall(function()
                    Remote:FireServer()
                end)
            end
        end

        task.wait(0.1)
    end
end)

